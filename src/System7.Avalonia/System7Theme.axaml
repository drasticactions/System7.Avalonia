<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:simple="using:Avalonia.Themes.Simple"
        xmlns:render="using:System7.Avalonia.Rendering" xmlns:theme="using:System7.Avalonia"
        xmlns:controls="using:System7.Avalonia.Controls" xmlns:converters="using:Avalonia.Controls.Converters"
        x:Class="System7.Avalonia.System7Theme">
  <simple:SimpleTheme />
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://System7.Avalonia/System7Geometry.axaml" />
        <ResourceInclude Source="avares://System7.Avalonia/System7Window.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="System7MenuBarBackgroundBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7MenuTitleForegroundBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7MenuBackgroundBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7MenuItemForegroundBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7MenuMarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7MenuShortcutBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7MenuBorderBrush">Black</SolidColorBrush>

      <SolidColorBrush x:Key="System7WindowContentBackgroundBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowTitleForegroundBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowFrameBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowTitleBarLightBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowTitleBarDarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowTitleStripeLightBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowTitleStripeDarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowDialogLightBrush">#CCCCFF</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowDialogDarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowTintLightBrush">#CCCCFF</SolidColorBrush>
      <SolidColorBrush x:Key="System7WindowTintDarkBrush">#333366</SolidColorBrush>

      <SolidColorBrush x:Key="System7ScrollBarBodyLightBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarBodyDarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarThumbLightBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarThumbDarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarArrowLightBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarArrowDarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarTrackLightBrush">White</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarTrackDarkBrush">Black</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarTintLightBrush">#CCCCFF</SolidColorBrush>
      <SolidColorBrush x:Key="System7ScrollBarTintDarkBrush">#333366</SolidColorBrush>
      <FontFamily x:Key="System7SystemFontFamily">avares://System7.Avalonia/Assets/Chicago12.ttf#System Seven Chicago</FontFamily>
      <x:Double x:Key="System7SystemFontSize">12</x:Double>
      <x:Double x:Key="System7ControlHeight">20</x:Double>
      <ItemsPanelTemplate x:Key="System7LayerPanelTemplate">
        <Panel />
      </ItemsPanelTemplate>
      <StreamGeometry x:Key="System7PopupTriangleGeometry">M0,0h11v1h-11z M1,1h9v1h-9z M2,2h7v1h-7z M3,3h5v1h-5z M4,4h3v1h-3z M5,5h1v1h-1z</StreamGeometry>
      <StreamGeometry x:Key="System7CheckMarkGeometry">M0,0h1v1h-1z M11,0h1v1h-1z M1,1h1v1h-1z M10,1h1v1h-1z M2,2h1v1h-1z M9,2h1v1h-1z M3,3h1v1h-1z M8,3h1v1h-1z M4,4h1v1h-1z M7,4h1v1h-1z M5,5h1v1h-1z M6,5h1v1h-1z M6,6h1v1h-1z M5,6h1v1h-1z M7,7h1v1h-1z M4,7h1v1h-1z M8,8h1v1h-1z M3,8h1v1h-1z M9,9h1v1h-1z M2,9h1v1h-1z M10,10h1v1h-1z M1,10h1v1h-1z M11,11h1v1h-1z M0,11h1v1h-1z</StreamGeometry>
      <StreamGeometry x:Key="System7SpeechSpeakerFrameGeometry">M1,0h17v1h-17z M0,1h1v15h-1z M18,1h1v15h-1z M1,16h17v1h-17z</StreamGeometry>
      <StreamGeometry x:Key="System7SpeechSpeakerInsetGeometry">M1,1h16v1h-16z M1,2h1v13h-1z</StreamGeometry>
      <Thickness x:Key="System7DefaultButtonRingMargin">-4</Thickness>
      <x:Double x:Key="System7ProgressBarThickness">16</x:Double>
      <converters:StringFormatConverter x:Key="System7ProgressTextConverter" />
      <!-- CDEF 62's progress bar. The label is XORed onto the bar, so it shows in the background color over the fill and the frame. -->
      <ControlTemplate x:Key="System7ProgressBarTemplate" TargetType="ProgressBar">
        <Panel Name="Bar" ClipToBounds="True"
               IsVisible="{TemplateBinding theme:System7Theme.IsProgressDrawn}">
          <!-- ProgressBar sizes its indicator by rounding the live value; CDEF 62 truncates the value it last drew, so the fill is drawn below. -->
          <Border Name="PART_Indicator" IsVisible="False" />
          <Rectangle Fill="{TemplateBinding Foreground}"
                     Clip="{Binding $self.Bounds,
                                    Converter={x:Static render:System7RoundRectConverter.Instance},
                                    ConverterParameter='0;Pen=1'}" />
          <Rectangle Margin="1,2"
                     Fill="{TemplateBinding Background}" />
          <Path Fill="{TemplateBinding Foreground}">
            <Path.Data>
              <MultiBinding Converter="{x:Static render:System7ProgressGeometryConverter.Instance}"
                            ConverterParameter="Fill">
                <Binding Path="#Bar.Bounds" />
                <TemplateBinding Property="theme:System7Theme.ProgressFraction" />
              </MultiBinding>
            </Path.Data>
          </Path>
          <Panel IsVisible="{TemplateBinding ShowProgressText}">
            <LayoutTransformControl Classes="label">
              <TextBlock Classes="label"
                         Foreground="{TemplateBinding Foreground}">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource System7ProgressTextConverter}">
                    <TemplateBinding Property="ProgressTextFormat" />
                    <TemplateBinding Property="Value" />
                    <TemplateBinding Property="Percentage" />
                    <TemplateBinding Property="Minimum" />
                    <TemplateBinding Property="Maximum" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </LayoutTransformControl>
            <Panel>
              <Panel.Clip>
                <MultiBinding Converter="{x:Static render:System7ProgressGeometryConverter.Instance}"
                              ConverterParameter="Ink">
                  <Binding Path="#Bar.Bounds" />
                  <TemplateBinding Property="theme:System7Theme.ProgressFraction" />
                </MultiBinding>
              </Panel.Clip>
              <LayoutTransformControl Classes="label">
                <TextBlock Classes="label"
                           Foreground="{TemplateBinding Background}">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource System7ProgressTextConverter}">
                      <TemplateBinding Property="ProgressTextFormat" />
                      <TemplateBinding Property="Value" />
                      <TemplateBinding Property="Percentage" />
                      <TemplateBinding Property="Minimum" />
                      <TemplateBinding Property="Maximum" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </LayoutTransformControl>
            </Panel>
          </Panel>
        </Panel>
      </ControlTemplate>
      <ControlTheme x:Key="System7ProgressBarTheme" TargetType="ProgressBar"
                    BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="theme:System7Theme.ProgressRetention" Value="Bar" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style Selector="^:not(:indeterminate)">
          <Setter Property="Template"
                  Value="{StaticResource System7ProgressBarTemplate}" />
        </Style>
        <!-- The label is centered with the odd pixel to its right and below it. -->
        <Style Selector="^ /template/ LayoutTransformControl.label">
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="Margin" Value="0,0,1,1" />
          <Setter Property="UseLayoutRounding" Value="False" />
        </Style>
        <Style Selector="^ /template/ TextBlock.label">
          <Setter Property="LineHeight"
                  Value="{DynamicResource System7TextLineHeight}" />
          <Setter Property="UseLayoutRounding" Value="False" />
        </Style>
        <Style Selector="^:horizontal">
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Height"
                  Value="{DynamicResource System7ProgressBarThickness}" />
        </Style>
        <!-- A vertical bar turns its label a quarter turn clockwise. -->
        <Style Selector="^:vertical /template/ LayoutTransformControl.label">
          <Setter Property="LayoutTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="^:vertical">
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Width"
                  Value="{DynamicResource System7ProgressBarThickness}" />
        </Style>
      </ControlTheme>
      <!-- CDEF 62's speaker: one of six ICONs for the value. -->
      <ControlTheme x:Key="System7SpeakerIndicatorTheme" TargetType="ProgressBar"
                    BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="theme:System7Theme.ProgressRetention" Value="Speaker" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_Indicator" IsVisible="False" />
              <Panel IsVisible="{Binding #Art.Data, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Rectangle Fill="{TemplateBinding Background}" />
                <Path Name="Art"
                      Fill="{TemplateBinding Foreground}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^[(theme|System7Theme.SpeakerFrame)=0] /template/ Path#Art">
          <Setter Property="Data"
                  Value="{StaticResource System7SpeakerFrame0Geometry}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.SpeakerFrame)=1] /template/ Path#Art">
          <Setter Property="Data"
                  Value="{StaticResource System7SpeakerFrame1Geometry}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.SpeakerFrame)=2] /template/ Path#Art">
          <Setter Property="Data"
                  Value="{StaticResource System7SpeakerFrame2Geometry}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.SpeakerFrame)=3] /template/ Path#Art">
          <Setter Property="Data"
                  Value="{StaticResource System7SpeakerFrame3Geometry}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.SpeakerFrame)=4] /template/ Path#Art">
          <Setter Property="Data"
                  Value="{StaticResource System7SpeakerFrame4Geometry}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.SpeakerFrame)=5] /template/ Path#Art">
          <Setter Property="Data"
                  Value="{StaticResource System7SpeakerFrame5Geometry}" />
        </Style>
        <Style Selector="^:horizontal, ^:vertical">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ControlTheme>
      <!-- The Speech control panel's speaker button. Two-bit and one-bit screens gray and invert it; color screens drop the frame and sink it. -->
      <ControlTheme x:Key="System7SpeechSpeakerButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7ButtonTheme}">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="17" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Rectangle Fill="{TemplateBinding Background}" />
              <Path Name="SpeakerFrame"
                    Data="{StaticResource System7SpeechSpeakerFrameGeometry}"
                    Fill="{TemplateBinding Foreground}" />
              <Rectangle Name="SpeakerGray" render:System7Pattern.Kind="Gray"
                         render:System7Pattern.Ink="{TemplateBinding Background}"
                         IsVisible="False" />
              <Path Name="Inset"
                    Data="{StaticResource System7SpeechSpeakerInsetGeometry}"
                    Fill="{TemplateBinding Foreground}"
                    IsVisible="False" />
              <Rectangle Name="Icon" Margin="2,3,0,0" Width="16" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Clip="{StaticResource System7SpeechSpeakerIconGeometry}"
                         render:System7Pattern.Local="True"
                         render:System7Pattern.Ink="{TemplateBinding Foreground}" />
              <Panel Name="Inverted" IsVisible="False">
                <Rectangle Margin="1"
                           Fill="{TemplateBinding Foreground}" />
                <Path Name="InvertedIcon" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Data="{StaticResource System7SpeechSpeakerIconGeometry}"
                      Fill="{TemplateBinding Background}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- A disabled icon keeps only the pixels on its own even checkerboard squares. -->
        <Style Selector="^:disabled /template/ Rectangle#Icon">
          <Setter Property="render:System7Pattern.Kind" Value="Gray" />
        </Style>
        <Style Selector="^:disabled /template/ Path#SpeakerFrame">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pressed:not(:disabled) /template/ Path#Inset">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pressed:not(:disabled) /template/ Rectangle#Icon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome], ^[(theme|System7Theme.ColorDepth)=Indexed2]">
          <Style Selector="^ /template/ Rectangle#Icon">
            <Setter Property="Margin" Value="2,2,0,0" />
          </Style>
          <Style Selector="^:disabled /template/ Path#SpeakerFrame">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:disabled /template/ Rectangle#SpeakerGray">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:pressed:not(:disabled) /template/ Path#Inset">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^:pressed:not(:disabled) /template/ Rectangle#Icon">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^:pressed:not(:disabled) /template/ Panel#Inverted">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
      </ControlTheme>
      <x:Double x:Key="System7ScrollBarThickness">16</x:Double>
      <x:Int32 x:Key="System7ScrollRepeatInterval">16</x:Int32>
      <x:Double x:Key="ScrollBarThickness">16</x:Double>
      <SolidColorBrush x:Key="System7ControlForegroundBrush" Color="Black" />
      <SolidColorBrush x:Key="System7ControlBackgroundBrush" Color="White" />
      <SolidColorBrush x:Key="System7ControlFrameBrush" Color="Black" />
      <DrawingBrush x:Key="System7DesktopBackgroundBrush" TileMode="Tile" DestinationRect="0,0,2,2" Stretch="None">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="White">
              <RectangleGeometry Rect="0,0,2,2" />
            </GeometryDrawing>
            <GeometryDrawing Brush="Black" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <SolidColorBrush x:Key="ThemeForegroundBrush" Color="Black" />
      <DrawingBrush x:Key="System7ColorDesktopBackgroundBrush" TileMode="Tile" DestinationRect="0,0,2,2" Stretch="None">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="#AAAAAA">
              <RectangleGeometry Rect="0,0,2,2" />
            </GeometryDrawing>
            <GeometryDrawing Brush="#666666" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="White" />
      <SolidColorBrush x:Key="ThemeBorderLowBrush" Color="Black" />
      <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="Black" />
      <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="Black" />
      <SolidColorBrush x:Key="ThemeControlMidBrush" Color="White" />
      <SolidColorBrush x:Key="ThemeControlHighBrush" Color="Black" />
      <SolidColorBrush x:Key="HighlightBrush" Color="Black" />
      <SolidColorBrush x:Key="HighlightForegroundBrush" Color="White" />
      <x:Double x:Key="ThemeDisabledOpacity">1</x:Double>
      <Thickness x:Key="System7WindowContentMargin">1,19,2,2</Thickness>
      <Thickness x:Key="System7RoundedWindowContentMargin">1,19,1,1</Thickness>
      <x:Int32 x:Key="System7RoundedWindowCornerDiameter">16</x:Int32>
      <Thickness x:Key="System7WindowResizableContentMargin">1,19,17,17</Thickness>
      <Thickness x:Key="System7DialogWindowContentMargin">8</Thickness>
      <Thickness x:Key="System7PlainDialogWindowContentMargin">1</Thickness>
      <Thickness x:Key="System7ShadowDialogWindowContentMargin">1,1,3,3</Thickness>
      <Thickness x:Key="System7MovableDialogWindowContentMargin">8,23,8,8</Thickness>
      <ControlTheme x:Key="System7RoundedWindowTheme" TargetType="controls:System7WindowFrame"
                    BasedOn="{StaticResource System7WindowFrameTheme}">
        <Setter Property="Kind" Value="RoundedDocument" />
        <Setter Property="CornerDiameter"
                Value="{DynamicResource System7RoundedWindowCornerDiameter}" />
      </ControlTheme>
      <ControlTheme x:Key="System7DialogWindowTheme" TargetType="controls:System7WindowFrame"
                    BasedOn="{StaticResource System7WindowFrameTheme}">
        <Setter Property="Kind" Value="Dialog" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="theme:System7Theme.UseNativeDialogKeys" Value="True" />
      </ControlTheme>
      <ControlTheme x:Key="System7PlainDialogWindowTheme" TargetType="controls:System7WindowFrame"
                    BasedOn="{StaticResource System7DialogWindowTheme}">
        <Setter Property="Kind" Value="PlainDialog" />
      </ControlTheme>
      <ControlTheme x:Key="System7ShadowDialogWindowTheme" TargetType="controls:System7WindowFrame"
                    BasedOn="{StaticResource System7DialogWindowTheme}">
        <Setter Property="Kind" Value="ShadowDialog" />
      </ControlTheme>
      <ControlTheme x:Key="System7MovableDialogWindowTheme" TargetType="controls:System7WindowFrame"
                    BasedOn="{StaticResource System7DialogWindowTheme}">
        <Setter Property="Kind" Value="MovableDialog" />
      </ControlTheme>
      <!-- CDEF 1's color thumb, drawn across a vertical bar; a horizontal bar transposes it. The scheme is the control's Tag. -->
      <ControlTemplate x:Key="System7ScrollBarThumbTemplate" TargetType="TemplatedControl">
        <Grid ColumnDefinitions="1,1,*,1,1" RowDefinitions="1,1,*,1">
          <Rectangle Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="4"
                     Fill="{TemplateBinding Tag,
                                            Converter={x:Static render:System7ColorScheme.Role},
                                            ConverterParameter={x:Static render:System7ScrollBarRole.ThumbFace}}" />
          <Rectangle Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                     Fill="{TemplateBinding Tag,
                                            Converter={x:Static render:System7ColorScheme.Role},
                                            ConverterParameter={x:Static render:System7ScrollBarRole.ThumbLight}}" />
          <Rectangle Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                     Fill="{TemplateBinding Tag,
                                            Converter={x:Static render:System7ColorScheme.Role},
                                            ConverterParameter={x:Static render:System7ScrollBarRole.ThumbLight}}" />
          <Rectangle Grid.Column="3" Grid.Row="1" Grid.RowSpan="3"
                     Fill="{TemplateBinding Tag,
                                            Converter={x:Static render:System7ColorScheme.Role},
                                            ConverterParameter={x:Static render:System7ScrollBarRole.ThumbDark}}" />
          <Rectangle Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="3"
                     Fill="{TemplateBinding Tag,
                                            Converter={x:Static render:System7ColorScheme.Role},
                                            ConverterParameter={x:Static render:System7ScrollBarRole.ThumbDark}}" />
          <Rectangle Grid.Column="1" Grid.ColumnSpan="3"
                     Fill="{TemplateBinding Tag,
                                            Converter={x:Static render:System7ColorScheme.Role},
                                            ConverterParameter={x:Static render:System7ScrollBarRole.ThumbTop}}" />
          <Panel Grid.ColumnSpan="5" Grid.RowSpan="4" Margin="5,3">
            <Rectangle Fill="{TemplateBinding Tag, Converter={x:Static render:System7ColorScheme.Role}, ConverterParameter={x:Static render:System7ScrollBarRole.ThumbLight}}" />
            <Path Data="{StaticResource System7ColorScrollBarPicture0Geometry}"
                  Fill="{TemplateBinding Tag,
                                         Converter={x:Static render:System7ColorScheme.Role},
                                         ConverterParameter={x:Static render:System7ScrollBarRole.Grip}}" />
            <Rectangle Height="1" VerticalAlignment="Top"
                       Fill="{TemplateBinding Tag,
                                              Converter={x:Static render:System7ColorScheme.Role},
                                              ConverterParameter={x:Static render:System7ScrollBarRole.ArrowFill}}" />
          </Panel>
        </Grid>
      </ControlTemplate>
      <!-- CDEF 1's color track: its color under an ltGray pattern. The scheme is the control's Tag. -->
      <ControlTemplate x:Key="System7ScrollBarTrackTemplate" TargetType="TemplatedControl">
        <Panel>
          <Rectangle Fill="{TemplateBinding Tag, Converter={x:Static render:System7ColorScheme.Role}, ConverterParameter={x:Static render:System7ScrollBarRole.Track}}" />
          <Rectangle render:System7Pattern.Kind="LightGray"
                     render:System7Pattern.Ink="{TemplateBinding Tag,
                                                                 Converter={x:Static render:System7ColorScheme.Role},
                                                                 ConverterParameter={x:Static render:System7ScrollBarRole.TrackPattern}}" />
        </Panel>
      </ControlTemplate>
      <ControlTemplate x:Key="System7ScrollBarTemplate" TargetType="ScrollBar">
        <Panel Background="Transparent" ClipToBounds="True">
          <!-- One-bit CDEF 1: an ltGray track, bitmap arrows and thumb, and a black frame. -->
          <Panel Name="Mono"
                 IsVisible="{TemplateBinding theme:System7Theme.ScrollBarScheme,
                                             Converter={x:Static render:System7ColorScheme.HasNoPalette}}">
            <Rectangle Classes="paper" />
            <Panel IsVisible="{TemplateBinding theme:System7Theme.IsActive}">
              <Rectangle Name="MonoTrack" render:System7Pattern.Kind="LightGray"
                         IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}" />
              <Panel Classes="square lineUp">
                <Rectangle Classes="paper" />
                <Path Name="MonoUpArt" Classes="ink" />
              </Panel>
              <Panel Classes="square lineDown">
                <Rectangle Classes="paper" />
                <Path Name="MonoDownArt" Classes="ink" />
              </Panel>
              <Panel Classes="square"
                     Margin="{TemplateBinding theme:System7Theme.ScrollThumbMargin}"
                     IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}">
                <Rectangle Classes="paper" />
                <Path Name="MonoThumbArt" Classes="ink" />
              </Panel>
            </Panel>
            <Rectangle Classes="ink"
                       Clip="{Binding $self.Bounds,
                                      Converter={x:Static render:System7RoundRectConverter.Instance},
                                      ConverterParameter='0;Pen=1'}" />
            <!-- The thumb's drag outline is XORed where ltGray is clear: the track turns black there and the thumb's ink turns white. -->
            <Panel Clip="{TemplateBinding theme:System7Theme.ScrollDragOutline}"
                   IsVisible="{TemplateBinding theme:System7Theme.ScrollDragOutline,
                                               Converter={x:Static ObjectConverters.IsNotNull}}">
              <Rectangle Name="MonoDragTrack" render:System7Pattern.Kind="LightGray" render:System7Pattern.Inverse="True" />
              <Panel Classes="square"
                     Margin="{TemplateBinding theme:System7Theme.ScrollThumbMargin}">
                <Rectangle Name="MonoDragThumb" render:System7Pattern.Kind="LightGray" render:System7Pattern.Inverse="True" />
              </Panel>
            </Panel>
          </Panel>
          <!-- Color CDEF 1: shaded arrows and thumb in the scroll bar's color roles. -->
          <Panel Name="Color"
                 IsVisible="{TemplateBinding theme:System7Theme.ScrollBarScheme,
                                             Converter={x:Static render:System7ColorScheme.HasPalette}}">
            <Rectangle Fill="{TemplateBinding theme:System7Theme.ScrollBarScheme, Converter={x:Static render:System7ColorScheme.Role}, ConverterParameter={x:Static render:System7ScrollBarRole.Background}}" />
            <Panel IsVisible="{TemplateBinding theme:System7Theme.IsActive}">
              <Rectangle Fill="{TemplateBinding theme:System7Theme.ScrollBarScheme, Converter={x:Static render:System7ColorScheme.Role}, ConverterParameter={x:Static render:System7ScrollBarRole.Surface}}" />
              <TemplatedControl Template="{StaticResource System7ScrollBarTrackTemplate}"
                                Tag="{TemplateBinding theme:System7Theme.ScrollBarScheme}"
                                IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}" />
              <Panel Name="ColorUp" Classes="square lineUp">
                <Rectangle Classes="arrowFace" />
                <Path Name="ColorUpOutline" Classes="arrowOutline upOutline" />
                <Path Name="ColorUpFill" Classes="arrowFill upFill"
                      IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}" />
                <Panel IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}">
                  <Rectangle Classes="edgeLight" Margin="1,1,1,0" Height="1" VerticalAlignment="Top" />
                  <Rectangle Classes="edgeLight" Margin="1,1,0,1" Width="1" HorizontalAlignment="Left" />
                  <Rectangle Classes="edgeDark" Margin="1,0,1,1" Height="1" VerticalAlignment="Bottom" />
                  <Rectangle Classes="edgeDark" Margin="0,1,1,1" Width="1" HorizontalAlignment="Right" />
                </Panel>
                <Rectangle Classes="colorFrame" />
              </Panel>
              <Panel Name="ColorDown" Classes="square lineDown">
                <Rectangle Classes="arrowFace" />
                <Path Name="ColorDownOutline" Classes="arrowOutline downOutline" />
                <Path Name="ColorDownFill" Classes="arrowFill downFill"
                      IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}" />
                <Panel IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}">
                  <Rectangle Classes="edgeLight" Margin="1,1,1,0" Height="1" VerticalAlignment="Top" />
                  <Rectangle Classes="edgeLight" Margin="1,1,0,1" Width="1" HorizontalAlignment="Left" />
                  <Rectangle Classes="edgeDark" Margin="1,0,1,1" Height="1" VerticalAlignment="Bottom" />
                  <Rectangle Classes="edgeDark" Margin="0,1,1,1" Width="1" HorizontalAlignment="Right" />
                </Panel>
                <Rectangle Classes="colorFrame" />
              </Panel>
              <TemplatedControl Classes="square thumb"
                                Template="{StaticResource System7ScrollBarThumbTemplate}"
                                Tag="{TemplateBinding theme:System7Theme.ScrollBarScheme}"
                                Margin="{TemplateBinding theme:System7Theme.ScrollThumbMargin}"
                                IsVisible="{TemplateBinding theme:System7Theme.IsScrollLive}" />
            </Panel>
            <Rectangle Classes="colorFrame" />
            <!-- The drag outline blackens the pixels that show the tracking gray: the track and thumb are redrawn inside it with those colors black. -->
            <Panel Clip="{TemplateBinding theme:System7Theme.ScrollDragOutline}"
                   IsVisible="{TemplateBinding theme:System7Theme.ScrollDragOutline,
                                               Converter={x:Static ObjectConverters.IsNotNull}}">
              <TemplatedControl Template="{StaticResource System7ScrollBarTrackTemplate}"
                                Tag="{TemplateBinding theme:System7Theme.ScrollBarScheme,
                                                      Converter={x:Static render:System7ScrollBarScheme.DragMasked}}" />
              <TemplatedControl Classes="square thumb"
                                Template="{StaticResource System7ScrollBarThumbTemplate}"
                                Tag="{TemplateBinding theme:System7Theme.ScrollBarScheme,
                                                      Converter={x:Static render:System7ScrollBarScheme.DragMasked}}"
                                Margin="{TemplateBinding theme:System7Theme.ScrollThumbMargin}" />
            </Panel>
          </Panel>
        </Panel>
      </ControlTemplate>
      <ControlTheme x:Key="System7ScrollBarTheme" TargetType="ScrollBar">
        <Setter Property="theme:System7Theme.UseNativeScrollTracking" Value="True" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource System7ControlFrameBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="Template"
                Value="{StaticResource System7ScrollBarTemplate}" />
        <!-- The arrows and thumb are squares at the ends of the bar and at the thumb position. -->
        <Style Selector="^:vertical">
          <Setter Property="Width"
                  Value="{DynamicResource System7ScrollBarThickness}" />
        </Style>
        <Style Selector="^:horizontal">
          <Setter Property="Height"
                  Value="{DynamicResource System7ScrollBarThickness}" />
        </Style>
        <Style Selector="^:vertical /template/ :is(Control).square">
          <Setter Property="Height"
                  Value="{Binding Bounds.Width,
                                  RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
          <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^:horizontal /template/ :is(Control).square">
          <Setter Property="Width"
                  Value="{Binding Bounds.Height,
                                  RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
          <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^:vertical /template/ :is(Control).lineDown">
          <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^:horizontal /template/ :is(Control).lineDown">
          <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="^:horizontal /template/ TemplatedControl.thumb">
          <Setter Property="RenderTransformOrigin" Value="0,0" />
          <Setter Property="RenderTransform" Value="matrix(0,1,1,0,0,0)" />
        </Style>
        <!-- Arrow and thumb artwork by orientation and state. -->
        <Style Selector="^:vertical /template/ Path#MonoUpArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarUpGeometry}" />
        </Style>
        <Style Selector="^:vertical /template/ Path#MonoDownArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarDownGeometry}" />
        </Style>
        <Style Selector="^:vertical /template/ Path#MonoThumbArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarVerticalThumbGeometry}" />
        </Style>
        <Style Selector="^:vertical[(theme|System7Theme.ScrollHighlight)=LineUp] /template/ Path#MonoUpArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarUpPressedGeometry}" />
        </Style>
        <Style Selector="^:vertical[(theme|System7Theme.ScrollHighlight)=LineDown] /template/ Path#MonoDownArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarDownPressedGeometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Path#MonoUpArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarLeftGeometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Path#MonoDownArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarRightGeometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Path#MonoThumbArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarHorizontalThumbGeometry}" />
        </Style>
        <Style Selector="^:horizontal[(theme|System7Theme.ScrollHighlight)=LineUp] /template/ Path#MonoUpArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarLeftPressedGeometry}" />
        </Style>
        <Style Selector="^:horizontal[(theme|System7Theme.ScrollHighlight)=LineDown] /template/ Path#MonoDownArt">
          <Setter Property="Data"
                  Value="{StaticResource System7ScrollBarRightPressedGeometry}" />
        </Style>
        <Style Selector="^:vertical /template/ Rectangle#MonoDragThumb">
          <Setter Property="Clip"
                  Value="{StaticResource System7ScrollBarVerticalThumbGeometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Rectangle#MonoDragThumb">
          <Setter Property="Clip"
                  Value="{StaticResource System7ScrollBarHorizontalThumbGeometry}" />
        </Style>
        <Style Selector="^:vertical /template/ Path#ColorUpOutline">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture2Geometry}" />
        </Style>
        <Style Selector="^:vertical /template/ Path#ColorUpFill">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture3Geometry}" />
        </Style>
        <Style Selector="^:vertical /template/ Path#ColorDownOutline">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture4Geometry}" />
        </Style>
        <Style Selector="^:vertical /template/ Path#ColorDownFill">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture5Geometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Path#ColorUpOutline">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture6Geometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Path#ColorUpFill">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture7Geometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Path#ColorDownOutline">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture8Geometry}" />
        </Style>
        <Style Selector="^:horizontal /template/ Path#ColorDownFill">
          <Setter Property="Data"
                  Value="{StaticResource System7ColorScrollBarPicture9Geometry}" />
        </Style>
        <!-- One bit: the control's own colors; a color screen that cannot show the bar's shades draws it in black and white. -->
        <Style Selector="^ /template/ Rectangle.paper">
          <Setter Property="Fill" Value="White" />
        </Style>
        <Style Selector="^ /template/ :is(Shape).ink">
          <Setter Property="Fill" Value="Black" />
        </Style>
        <Style Selector="^ /template/ Rectangle#MonoTrack, ^ /template/ Rectangle#MonoDragTrack">
          <Setter Property="render:System7Pattern.Ink" Value="Black" />
        </Style>
        <Style Selector="^ /template/ Rectangle#MonoDragThumb">
          <Setter Property="render:System7Pattern.Ink" Value="White" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome] /template/ Rectangle.paper">
          <Setter Property="Fill"
                  Value="{Binding Background,
                                  RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome] /template/ :is(Shape).ink">
          <Setter Property="Fill"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome] /template/ Rectangle#MonoTrack, ^[(theme|System7Theme.ColorDepth)=Monochrome] /template/ Rectangle#MonoDragTrack">
          <Setter Property="render:System7Pattern.Ink"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome] /template/ Rectangle#MonoDragThumb">
          <Setter Property="render:System7Pattern.Ink"
                  Value="{Binding Background,
                                  RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
        </Style>
        <Style Selector="^ /template/ Rectangle.edgeLight">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.Background}}" />
        </Style>
        <Style Selector="^ /template/ Rectangle.edgeDark">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.TrackPattern}}" />
        </Style>
        <Style Selector="^ /template/ Rectangle.colorFrame">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.Frame}}" />
          <Setter Property="Clip"
                  Value="{Binding $self.Bounds,
                                  Converter={x:Static render:System7RoundRectConverter.Instance},
                                  ConverterParameter='0;Pen=1'}" />
        </Style>
        <!-- Arrow colors: an idle bar draws only a light outline; a pressed arrow fills with the frame color. -->
        <Style Selector="^ /template/ Rectangle.arrowFace">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.ArrowFace}}" />
        </Style>
        <Style Selector="^ /template/ Path.arrowOutline">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.ThumbDark}}" />
        </Style>
        <Style Selector="^ /template/ Path.arrowFill">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.ArrowFill}}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.IsScrollLive)=False] /template/ Rectangle.arrowFace">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.Surface}}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.IsScrollLive)=False] /template/ Path.arrowOutline">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.TrackPattern}}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ScrollHighlight)=LineUp] /template/ Path.upOutline, ^[(theme|System7Theme.ScrollHighlight)=LineUp] /template/ Path.upFill, ^[(theme|System7Theme.ScrollHighlight)=LineDown] /template/ Path.downOutline, ^[(theme|System7Theme.ScrollHighlight)=LineDown] /template/ Path.downFill">
          <Setter Property="Fill"
                  Value="{Binding (theme:System7Theme.ScrollBarScheme),
                                  RelativeSource={RelativeSource AncestorType=ScrollBar},
                                  Converter={x:Static render:System7ColorScheme.Role},
                                  ConverterParameter={x:Static render:System7ScrollBarRole.Frame}}" />
        </Style>
      </ControlTheme>
      <!-- A centered title, with QuickDraw's rounding: odd slack leaves the extra pixel right of the text and above it. -->
      <DataTemplate x:Key="System7CenteredTitleTemplate" DataType="x:String">
        <TextBlock Text="{Binding}"
                   LineHeight="{DynamicResource System7TextLineHeight}"
                   TextAlignment="Center" Margin="0,0,1,0" UseLayoutRounding="False" />
      </DataTemplate>
      <!-- CDEF 0 push button: a round rectangle whose corners are half its height, with the title centered inside. -->
      <ControlTheme x:Key="System7ButtonTheme" TargetType="Button">
        <Setter Property="theme:System7Theme.UseNativeButtonTracking" Value="True" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource System7ControlFrameBrush}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource System7ControlHeight}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Panel Name="DefaultRing"
                     Margin="{DynamicResource System7DefaultButtonRingMargin}"
                     IsVisible="{TemplateBinding IsDefault}">
                <Rectangle Clip="{Binding $self.Bounds,
                                          Converter={x:Static render:System7RoundRectConverter.Instance},
                                          ConverterParameter='16;Pen=3'}"
                           Fill="{TemplateBinding Foreground}" />
                <Rectangle Name="DefaultRingGray"
                           Clip="{Binding $self.Bounds,
                                          Converter={x:Static render:System7RoundRectConverter.Instance},
                                          ConverterParameter='16;Pen=3'}"
                           render:System7Pattern.Kind="Gray" render:System7Pattern.Inverse="True"
                           render:System7Pattern.Ink="{TemplateBinding Background}"
                           IsVisible="False" />
              </Panel>
              <Rectangle Name="Paper"
                         Fill="{TemplateBinding Background}"
                         IsVisible="False" />
              <Rectangle Name="Body"
                         Clip="{Binding $self.Bounds,
                                        Converter={x:Static render:System7RoundRectConverter.Instance},
                                        ConverterParameter=Half}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                UseLayoutRounding="False"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.DataTemplates>
                  <StaticResource ResourceKey="System7CenteredTitleTemplate" />
                </ContentPresenter.DataTemplates>
              </ContentPresenter>
              <Rectangle Name="Gray" render:System7Pattern.Kind="Gray" IsVisible="False">
                <Rectangle.Clip>
                  <MultiBinding Converter="{x:Static render:System7RoundRectConverter.Instance}">
                    <Binding Path="Bounds"
                             RelativeSource="{RelativeSource Self}" />
                    <TemplateBinding Property="Bounds" />
                  </MultiBinding>
                </Rectangle.Clip>
                <render:System7Pattern.Ink>
                  <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                    <TemplateBinding Property="Background" />
                    <TemplateBinding Property="theme:System7Theme.ColorDepth" />
                  </MultiBinding>
                </render:System7Pattern.Ink>
              </Rectangle>
              <Rectangle Name="Frame"
                         Clip="{Binding $self.Bounds,
                                        Converter={x:Static render:System7RoundRectConverter.Instance},
                                        ConverterParameter='Half;Pen=1'}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- The body, title, and frame in the screen's nearest colors. -->
        <Style Selector="^ /template/ Rectangle#Body">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Rectangle#Frame">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="BorderBrush"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^[IsDefault=True]">
          <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#DefaultRingGray">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- A disabled title is drawn in a true gray, or through the gray pattern where the screen has none. -->
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#Gray">
          <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static render:System7Colors.Dithers}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- Held down with the pointer inside, or by its dialog key, the body and title swap colors. -->
        <Style Selector="^[(theme|System7Theme.IsButtonPointerWithin)=True]:pressed:not(:disabled), ^[(theme|System7Theme.IsDialogButtonPressed)=True]:not(:disabled)">
          <Style Selector="^ /template/ Rectangle#Body">
            <Setter Property="Fill">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Foreground"
                         RelativeSource="{RelativeSource AncestorType=Button}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=Button}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=Button}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=Button}" />
              </MultiBinding>
            </Setter>
          </Style>
        </Style>
        <!-- One bit: the corners show the paper, the pattern grays inside the frame, and a pressed frame turns to paper. -->
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome]">
          <Style Selector="^ /template/ Rectangle#Paper">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Rectangle#Gray">
            <Setter Property="Margin" Value="1" />
          </Style>
          <Style Selector="^ /template/ Rectangle#Frame">
            <Setter Property="Fill"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=Button}}" />
          </Style>
          <Style Selector="^[(theme|System7Theme.IsButtonPointerWithin)=True]:pressed:not(:disabled) /template/ Rectangle#Frame, ^[(theme|System7Theme.IsDialogButtonPressed)=True]:not(:disabled) /template/ Rectangle#Frame">
            <Setter Property="Fill"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=Button}}" />
          </Style>
        </Style>
      </ControlTheme>
      <!-- A picture button: its content inside a round rectangle that is grayed while disabled and inverted while held. -->
      <ControlTheme x:Key="System7PictureButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7ButtonTheme}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsHitTestVisible"
                Value="{Binding (theme:System7Theme.IsActive),
                                RelativeSource={RelativeSource Self}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" ClipToBounds="True" RenderOptions.BitmapInterpolationMode="None">
              <Rectangle Classes="shape"
                         Fill="{TemplateBinding Background}" />
              <Viewbox Stretch="None" ClipToBounds="False"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" />
              </Viewbox>
              <Rectangle Classes="frame"
                         Fill="{TemplateBinding Foreground}" />
              <Rectangle Name="Gray" Classes="inner" Margin="1" render:System7Pattern.Kind="Gray"
                         render:System7Pattern.Ink="{TemplateBinding Background}"
                         IsVisible="False" />
              <Image Name="Highlight" Classes="shape" Source="/Assets/White.png" Stretch="Fill"
                     RenderOptions.BitmapBlendingMode="Difference" IsVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- The corners are half the button's height. -->
        <Style Selector="^ /template/ Image.shape">
          <Setter Property="Clip"
                  Value="{Binding $self.Bounds,
                                  Converter={x:Static render:System7RoundRectConverter.Instance},
                                  ConverterParameter=Half}" />
        </Style>
        <Style Selector="^ /template/ Rectangle.frame">
          <Setter Property="Clip"
                  Value="{Binding $self.Bounds,
                                  Converter={x:Static render:System7RoundRectConverter.Instance},
                                  ConverterParameter='Half;Pen=1'}" />
        </Style>
        <Style Selector="^ /template/ Rectangle.inner">
          <Setter Property="Clip">
            <MultiBinding Converter="{x:Static render:System7RoundRectConverter.Instance}">
              <Binding Path="Bounds"
                       RelativeSource="{RelativeSource Self}" />
              <Binding Path="Bounds"
                       RelativeSource="{RelativeSource AncestorType=Button}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#Gray, ^[(theme|System7Theme.IsActive)=False] /template/ Rectangle#Gray">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[(theme|System7Theme.IsActive)=True]">
          <Style Selector="^[(theme|System7Theme.IsButtonPointerWithin)=True]:pressed:not(:disabled) /template/ Image#Highlight, ^[(theme|System7Theme.IsDialogButtonPressed)=True]:not(:disabled) /template/ Image#Highlight">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7SquarePictureButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7PictureButtonTheme}">
        <Style Selector="^ /template/ Image.shape">
          <Setter Property="Clip"
                  Value="{Binding $self.Bounds,
                                  Converter={x:Static render:System7RoundRectConverter.Instance},
                                  ConverterParameter=0}" />
        </Style>
        <Style Selector="^ /template/ Rectangle.frame">
          <Setter Property="Clip"
                  Value="{Binding $self.Bounds,
                                  Converter={x:Static render:System7RoundRectConverter.Instance},
                                  ConverterParameter='0;Pen=1'}" />
        </Style>
        <Style Selector="^ /template/ Rectangle.inner">
          <Setter Property="Clip"
                  Value="{Binding $self.Bounds,
                                  Converter={x:Static render:System7RoundRectConverter.Instance},
                                  ConverterParameter=0}" />
        </Style>
      </ControlTheme>
      <!-- The media buttons: a 27-pixel picture in a frame with 3-pixel corners. -->
      <ControlTheme x:Key="System7MediaButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7ButtonTheme}">
        <Setter Property="Width" Value="29" />
        <Setter Property="Height" Value="29" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsHitTestVisible"
                Value="{Binding (theme:System7Theme.IsActive),
                                RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" RenderOptions.BitmapInterpolationMode="None">
              <Rectangle Fill="{TemplateBinding Background}"
                         Clip="{Binding $self.Bounds,
                                        Converter={x:Static render:System7RoundRectConverter.Instance},
                                        ConverterParameter=3}" />
              <Rectangle Fill="{TemplateBinding Foreground}"
                         Clip="{Binding $self.Bounds,
                                        Converter={x:Static render:System7RoundRectConverter.Instance},
                                        ConverterParameter='3;Pen=1'}" />
              <Viewbox Stretch="None" Margin="1,1,0,0" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Viewbox>
              <Rectangle Name="Gray" Margin="1" render:System7Pattern.Kind="Gray"
                         render:System7Pattern.Ink="{TemplateBinding Background}"
                         IsVisible="False" />
              <Image Name="Highlight" Source="/Assets/White.png" Stretch="Fill" RenderOptions.BitmapBlendingMode="Difference"
                     IsVisible="False"
                     Clip="{Binding $self.Bounds,
                                    Converter={x:Static render:System7RoundRectConverter.Instance},
                                    ConverterParameter=3}" />
              <Rectangle Name="HighlightFrame"
                         Fill="{TemplateBinding Foreground}"
                         IsVisible="False"
                         Clip="{Binding $self.Bounds,
                                        Converter={x:Static render:System7RoundRectConverter.Instance},
                                        ConverterParameter='3;Pen=1'}" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled /template/ Rectangle#Gray">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- An inactive window shows its media buttons inverted. -->
        <Style Selector="^[(theme|System7Theme.IsActive)=False] /template/ Image#Highlight, ^[(theme|System7Theme.IsActive)=False] /template/ Rectangle#HighlightFrame">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[(theme|System7Theme.IsActive)=True]">
          <Style Selector="^[(theme|System7Theme.IsButtonPointerWithin)=True]:pressed:not(:disabled) /template/ Image#Highlight, ^[(theme|System7Theme.IsDialogButtonPressed)=True]:not(:disabled) /template/ Image#Highlight">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^[(theme|System7Theme.IsButtonPointerWithin)=True]:pressed:not(:disabled) /template/ Rectangle#HighlightFrame, ^[(theme|System7Theme.IsDialogButtonPressed)=True]:not(:disabled) /template/ Rectangle#HighlightFrame">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7MediaPauseButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7MediaButtonTheme}">
        <Setter Property="Content" Value="Pause" />
        <Setter Property="ContentTemplate">
          <DataTemplate>
            <Image Width="27" Height="27" Stretch="None"
                   Source="{StaticResource System7MediaPauseImage}" />
          </DataTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7MediaPlayButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7MediaButtonTheme}">
        <Setter Property="Content" Value="Play" />
        <Setter Property="ContentTemplate">
          <DataTemplate>
            <Image Width="27" Height="27" Stretch="None"
                   Source="{StaticResource System7MediaPlayImage}" />
          </DataTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7MediaStopButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7MediaButtonTheme}">
        <Setter Property="Content" Value="Stop" />
        <Setter Property="ContentTemplate">
          <DataTemplate>
            <Image Width="27" Height="27" Stretch="None"
                   Source="{StaticResource System7MediaStopImage}" />
          </DataTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7MediaRecordButtonTheme" TargetType="Button"
                    BasedOn="{StaticResource System7MediaButtonTheme}">
        <Setter Property="Content" Value="Record" />
        <Setter Property="ContentTemplate">
          <DataTemplate>
            <Image Width="27" Height="27" Stretch="None"
                   Source="{StaticResource System7MediaRecordImage}" />
          </DataTemplate>
        </Setter>
      </ControlTheme>
      <!-- A left-aligned title, centered vertically with the odd pixel above as CDEF 0 stacks its lines. -->
      <DataTemplate x:Key="System7TitleTemplate" DataType="x:String">
        <TextBlock Text="{Binding}"
                   LineHeight="{DynamicResource System7TextLineHeight}"
                   UseLayoutRounding="False" />
      </DataTemplate>
      <ControlTheme x:Key="System7ToggleButtonTheme" TargetType="ToggleButton">
        <Setter Property="theme:System7Theme.UseNativeButtonTracking" Value="True" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource System7ControlFrameBrush}" />
        <Setter Property="MinHeight"
                Value="{DynamicResource System7ControlHeight}" />
        <Setter Property="Padding" Value="18,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <!-- CDEF 0 on a color screen: the window's color behind the control, its colors mapped to the screen, and a true gray title while disabled. -->
        <Style Selector="^ /template/ Rectangle#Paper">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="(theme:System7Theme.WindowBackground)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Rectangle#Gray">
          <Setter Property="render:System7Pattern.Ink">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="(theme:System7Theme.WindowBackground)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ :is(Shape).frame, ^ /template/ :is(Shape).pressed, ^ /template/ :is(Shape).mark">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="BorderBrush"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.WindowBackground)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#Gray">
          <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static render:System7Colors.Dithers}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.WindowBackground)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ToggleButton}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:checked /template/ :is(Shape).mark">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Held down with the pointer inside, the box frame thickens. -->
        <Style Selector="^[(theme|System7Theme.IsButtonPointerWithin)=True]:pressed:not(:disabled)">
          <Style Selector="^ /template/ :is(Shape).frame">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ :is(Shape).pressed">
            <Setter Property="IsVisible" Value="True" />
          </Style>
        </Style>
        <!-- One bit: the control's own colors, drawn as they are. -->
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome]">
          <Style Selector="^ /template/ Rectangle#Paper">
            <Setter Property="Fill"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </Style>
          <Style Selector="^ /template/ Rectangle#Gray">
            <Setter Property="render:System7Pattern.Ink"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </Style>
          <Style Selector="^ /template/ :is(Shape).frame, ^ /template/ :is(Shape).pressed, ^ /template/ :is(Shape).mark">
            <Setter Property="Fill"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
          </Style>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7CheckBoxTheme" TargetType="CheckBox"
                    BasedOn="{StaticResource System7ToggleButtonTheme}">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Rectangle Name="Paper" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                UseLayoutRounding="False"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.DataTemplates>
                  <StaticResource ResourceKey="System7TitleTemplate" />
                </ContentPresenter.DataTemplates>
              </ContentPresenter>
              <Rectangle Name="Gray" render:System7Pattern.Kind="Gray" IsVisible="False" />
              <Panel Width="12" Height="12" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle Classes="frame"
                           Clip="{Binding $self.Bounds,
                                          Converter={x:Static render:System7RoundRectConverter.Instance},
                                          ConverterParameter='0;Pen=1'}" />
                <Rectangle Classes="pressed"
                           Clip="{Binding $self.Bounds,
                                          Converter={x:Static render:System7RoundRectConverter.Instance},
                                          ConverterParameter='0;Pen=2'}"
                           IsVisible="False" />
                <Path Classes="mark"
                      Data="{StaticResource System7CheckMarkGeometry}"
                      IsVisible="False" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7RadioButtonTheme" TargetType="RadioButton"
                    BasedOn="{StaticResource System7ToggleButtonTheme}">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Rectangle Name="Paper" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                UseLayoutRounding="False"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.DataTemplates>
                  <StaticResource ResourceKey="System7TitleTemplate" />
                </ContentPresenter.DataTemplates>
              </ContentPresenter>
              <Rectangle Name="Gray" render:System7Pattern.Kind="Gray" IsVisible="False" />
              <Panel Width="12" Height="12" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle Classes="frame"
                           Clip="{Binding $self.Bounds,
                                          Converter={x:Static render:System7RoundRectConverter.Instance},
                                          ConverterParameter='12;Pen=1'}" />
                <Rectangle Classes="pressed"
                           Clip="{Binding $self.Bounds,
                                          Converter={x:Static render:System7RoundRectConverter.Instance},
                                          ConverterParameter='12;Pen=2'}"
                           IsVisible="False" />
                <Rectangle Classes="mark" Margin="3"
                           Clip="{Binding $self.Bounds,
                                          Converter={x:Static render:System7RoundRectConverter.Instance},
                                          ConverterParameter=6}"
                           IsVisible="False" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7CompactCheckBoxTheme" TargetType="CheckBox"
                    BasedOn="{StaticResource System7CheckBoxTheme}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="16" />
      </ControlTheme>
      <ControlTheme x:Key="System7CompactRadioButtonTheme" TargetType="RadioButton"
                    BasedOn="{StaticResource System7RadioButtonTheme}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="16" />
      </ControlTheme>
      <!-- The Speech control panel's CDEF 5 draws in one bit on every screen. -->
      <ControlTheme x:Key="System7SpeechCheckBoxTheme" TargetType="CheckBox"
                    BasedOn="{StaticResource System7CompactCheckBoxTheme}">
        <Setter Property="Focusable" Value="True" />
        <Style Selector="^ /template/ Rectangle#Paper">
          <Setter Property="Fill"
                  Value="{Binding Background,
                                  RelativeSource={RelativeSource AncestorType=CheckBox}}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=CheckBox}}" />
        </Style>
        <Style Selector="^ /template/ Rectangle#Gray">
          <Setter Property="render:System7Pattern.Ink"
                  Value="{Binding Background,
                                  RelativeSource={RelativeSource AncestorType=CheckBox}}" />
        </Style>
        <Style Selector="^ /template/ :is(Shape).frame, ^ /template/ :is(Shape).pressed, ^ /template/ :is(Shape).mark">
          <Setter Property="Fill"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=CheckBox}}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=CheckBox}}" />
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#Gray">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- CDEF 5 redraws its rightmost column without the disabled pattern. -->
        <Style Selector="^ /template/ Rectangle#Gray">
          <Setter Property="Margin" Value="0,0,1,0" />
        </Style>
      </ControlTheme>
      <!-- The Speech control panel's CDEF 5 draws in one bit on every screen. -->
      <ControlTheme x:Key="System7SpeechRadioButtonTheme" TargetType="RadioButton"
                    BasedOn="{StaticResource System7CompactRadioButtonTheme}">
        <Setter Property="Focusable" Value="True" />
        <Style Selector="^ /template/ Rectangle#Paper">
          <Setter Property="Fill"
                  Value="{Binding Background,
                                  RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style Selector="^ /template/ Rectangle#Gray">
          <Setter Property="render:System7Pattern.Ink"
                  Value="{Binding Background,
                                  RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style Selector="^ /template/ :is(Shape).frame, ^ /template/ :is(Shape).pressed, ^ /template/ :is(Shape).mark">
          <Setter Property="Fill"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#Gray">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- On a color screen a checked radio button keeps its thin frame while held. -->
        <Style Selector="^:checked">
          <Style Selector="^ /template/ :is(Shape).frame">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ :is(Shape).pressed">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome]">
          <Style Selector="^[(theme|System7Theme.IsButtonPointerWithin)=True]:pressed:not(:disabled)">
            <Style Selector="^ /template/ :is(Shape).frame">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ :is(Shape).pressed">
              <Setter Property="IsVisible" Value="True" />
            </Style>
          </Style>
        </Style>
      </ControlTheme>
      <!-- The control panel sliders: artwork over a stock Track that places the thumb. The controls handle the pointer themselves. -->
      <ControlTheme x:Key="System7MemorySliderTheme" TargetType="controls:System7MemorySlider">
        <Setter Property="Width" Value="144" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Minimum" Value="1" />
        <Setter Property="Maximum" Value="126" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" ClipToBounds="True">
              <Rectangle Fill="{TemplateBinding Background}" />
              <Path Margin="0,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Data="{StaticResource System7MemorySliderTrackGeometry}"
                    Fill="{TemplateBinding Foreground}" />
              <Track Margin="2,1,2,0" Height="18" VerticalAlignment="Top" Orientation="Horizontal"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}">
                <Thumb Width="15" Height="18" IsHitTestVisible="False">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Panel>
                        <Rectangle Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=controls:System7MemorySlider}}" />
                        <Path Data="{StaticResource System7MemorySliderThumbGeometry}"
                              Fill="{Binding Foreground,
                                             RelativeSource={RelativeSource AncestorType=controls:System7MemorySlider}}" />
                      </Panel>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7SoundSliderTheme" TargetType="controls:System7SoundSlider">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="104" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="7" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" ClipToBounds="True">
              <Rectangle Fill="{TemplateBinding Background}" />
              <Path HorizontalAlignment="Left" VerticalAlignment="Top"
                    Data="{StaticResource System7SoundSliderTrackGeometry}"
                    Fill="{TemplateBinding Foreground}" />
              <Track Margin="1,5,0,4" Width="23" HorizontalAlignment="Left" Orientation="Vertical" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}">
                <Thumb Width="23" Height="11" IsHitTestVisible="False">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Panel>
                        <Rectangle Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=controls:System7SoundSlider}}" />
                        <Path Data="{StaticResource System7SoundSliderThumbGeometry}"
                              Fill="{Binding Foreground,
                                             RelativeSource={RelativeSource AncestorType=controls:System7SoundSlider}}" />
                      </Panel>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7NetworkSliderTheme" TargetType="controls:System7NetworkSlider">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="10" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" ClipToBounds="True">
              <Rectangle Fill="{TemplateBinding Background}" />
              <Path Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Data="{StaticResource System7NetworkSliderTrackGeometry}"
                    Fill="{TemplateBinding Foreground}" />
              <Canvas>
                <Panel Canvas.Left="{TemplateBinding ThumbPosition}"
                       Canvas.Top="1" Width="11" Height="18">
                  <Rectangle Fill="{TemplateBinding Background}" />
                  <Path Data="{StaticResource System7NetworkSliderThumbGeometry}"
                        Fill="{TemplateBinding Foreground}" />
                </Panel>
              </Canvas>
            </Panel>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="System7SpeechSliderTheme" TargetType="controls:System7SpeechSlider">
        <Setter Property="Width" Value="124" />
        <Setter Property="Height" Value="29" />
        <Setter Property="Minimum" Value="20" />
        <Setter Property="Maximum" Value="400" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Image Name="TrackImage" Width="124" Height="29" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Source="{StaticResource System7SpeechSliderIndexed8TrackImage}" />
              <Track Margin="4,2,5,0" Height="16" VerticalAlignment="Top" Orientation="Horizontal"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}">
                <Thumb Name="Thumb" Width="15" Height="16" IsHitTestVisible="False">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Image Width="15" Height="16" Stretch="None"
                             Source="{StaticResource System7SpeechSliderIndexed8ThumbImage}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- The Speech control panel draws its rate slider from artwork for each screen depth. -->
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome] /template/ Image#TrackImage">
          <Setter Property="Source"
                  Value="{StaticResource System7SpeechSliderMonochromeTrackImage}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome] /template/ Thumb#Thumb">
          <Setter Property="Template">
            <ControlTemplate>
              <Image Width="15" Height="16" Stretch="None"
                     Source="{StaticResource System7SpeechSliderMonochromeThumbImage}" />
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Indexed2] /template/ Image#TrackImage">
          <Setter Property="Source"
                  Value="{StaticResource System7SpeechSliderIndexed2TrackImage}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Indexed2] /template/ Thumb#Thumb">
          <Setter Property="Template">
            <ControlTemplate>
              <Image Width="15" Height="16" Stretch="None"
                     Source="{StaticResource System7SpeechSliderIndexed2ThumbImage}" />
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Indexed4] /template/ Image#TrackImage">
          <Setter Property="Source"
                  Value="{StaticResource System7SpeechSliderIndexed4TrackImage}" />
        </Style>
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Indexed4] /template/ Thumb#Thumb">
          <Setter Property="Template">
            <ControlTemplate>
              <Image Width="15" Height="16" Stretch="None"
                     Source="{StaticResource System7SpeechSliderIndexed4ThumbImage}" />
            </ControlTemplate>
          </Setter>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type controls:System7IconView}"
                    TargetType="controls:System7IconView">
        <Setter Property="Template">
          <ControlTemplate>
            <Image Stretch="None">
              <Image.Source>
                <MultiBinding Converter="{x:Static render:System7IconConverters.Image}">
                  <TemplateBinding Property="Icon" />
                  <TemplateBinding Property="theme:System7Theme.ColorDepth" />
                </MultiBinding>
              </Image.Source>
            </Image>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <!-- MDEF 0's menu frame, one-pixel shadow, and scroll arrows around the menu's items. A pop-up menu draws in its control's colors. -->
      <ControlTheme x:Key="System7PopupMenuSurfaceTheme" TargetType="controls:System7MenuSurface">
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Rectangle Classes="surface" Margin="0,0,1,1" />
              <Rectangle Classes="ink" Margin="0,0,1,1"
                         Clip="{Binding $self.Bounds,
                                        Converter={x:Static render:System7RoundRectConverter.Instance},
                                        ConverterParameter='0;Pen=1'}" />
              <Rectangle Classes="ink" Margin="0,3,0,0" Width="1" HorizontalAlignment="Right" />
              <Rectangle Classes="ink" Margin="3,0,0,0" Height="1" VerticalAlignment="Bottom" />
              <Canvas Margin="1,1,2,2" ClipToBounds="True">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Canvas.Top="{TemplateBinding ContentTop}"
                                  MinWidth="{Binding $parent[Canvas].Bounds.Width}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Canvas>
              <!-- A long menu shows an arrow in place of its first or last visible row. -->
              <Panel Margin="1,1,2,0" Height="16" VerticalAlignment="Top"
                     IsVisible="{TemplateBinding CanScrollUp}">
                <Rectangle Classes="surface" />
                <Path Classes="indicator" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Data="{StaticResource System7MenuScrollUpGeometry}" />
              </Panel>
              <Panel Margin="1,0,2,2" Height="16" VerticalAlignment="Bottom"
                     IsVisible="{TemplateBinding CanScrollDown}">
                <Rectangle Classes="surface" />
                <Path Classes="indicator" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Data="{StaticResource System7MenuScrollDownGeometry}" />
              </Panel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Rectangle.surface">
          <Setter Property="Fill"
                  Value="{Binding SurfaceBackground,
                                  RelativeSource={RelativeSource AncestorType=controls:System7MenuSurface}}" />
        </Style>
        <Style Selector="^ /template/ :is(Shape).ink">
          <Setter Property="Fill"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=controls:System7MenuSurface}}" />
        </Style>
        <Style Selector="^ /template/ Path.indicator">
          <Setter Property="Fill"
                  Value="{Binding ScrollIndicatorBrush,
                                  RelativeSource={RelativeSource AncestorType=controls:System7MenuSurface}}" />
        </Style>
      </ControlTheme>
      <!-- A menu maps its colors to the screen, and draws its frame black on a color screen. -->
      <ControlTheme x:Key="System7MenuSurfaceTheme" TargetType="controls:System7MenuSurface"
                    BasedOn="{StaticResource System7PopupMenuSurfaceTheme}">
        <Setter Property="Foreground"
                Value="{DynamicResource System7MenuBorderBrush}" />
        <Setter Property="SurfaceBackground"
                Value="{DynamicResource System7MenuBackgroundBrush}" />
        <Setter Property="ScrollIndicatorBrush"
                Value="{DynamicResource System7MenuItemForegroundBrush}" />
        <Style Selector="^ /template/ Rectangle.surface">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="SurfaceBackground"
                       RelativeSource="{RelativeSource AncestorType=controls:System7MenuSurface}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=controls:System7MenuSurface}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ :is(Shape).ink">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.BlackInColor}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=controls:System7MenuSurface}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=controls:System7MenuSurface}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Path.indicator">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="ScrollIndicatorBrush"
                       RelativeSource="{RelativeSource AncestorType=controls:System7MenuSurface}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=controls:System7MenuSurface}" />
            </MultiBinding>
          </Setter>
        </Style>
      </ControlTheme>
      <!-- MDEF 0's item row, shared by menu items and pop-up items: colors mapped to the screen, and a disabled part in a true gray. -->
      <ControlTheme x:Key="System7MenuRowTheme" TargetType="TemplatedControl">
        <Style Selector="^ /template/ Rectangle#Paper">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ TextBlock#Text, ^ /template/ ContentPresenter#PART_HeaderPresenter">
          <Setter Property="TextElement.Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Path#StyledText">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ TextBlock#Mark">
          <Setter Property="TextElement.Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="(theme:System7Theme.MenuMarkBrush)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Rectangle#Gray, ^ /template/ Rectangle#TextGray, ^ /template/ Rectangle#MarkGray">
          <Setter Property="render:System7Pattern.Ink">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#Text, ^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
          <Setter Property="TextElement.Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Path#StyledText">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#Mark">
          <Setter Property="TextElement.Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="(theme:System7Theme.MenuMarkBrush)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#TextGray">
          <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static render:System7Colors.Dithers}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#MarkGray">
          <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static render:System7Colors.Dithers}">
              <Binding Path="(theme:System7Theme.MenuMarkBrush)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=TemplatedControl}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- A plain title is Chicago text; a styled one is QuickDraw's styled glyphs. -->
        <Style Selector="^ /template/ TextBlock#Text">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[(theme|System7Theme.TextStyle)=Plain]">
          <Style Selector="^ /template/ TextBlock#Text">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Path#StyledText">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7MenuItemTheme" TargetType="MenuItem"
                    BasedOn="{StaticResource System7MenuRowTheme}">
        <Setter Property="FocusAdorner"
                Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight"
                Value="{DynamicResource System7MenuItemHeight}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7MenuItemForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7MenuBackgroundBrush}" />
        <Setter Property="theme:System7Theme.MenuMarkBrush"
                Value="{DynamicResource System7MenuMarkBrush}" />
        <Setter Property="theme:System7Theme.MenuShortcutBrush"
                Value="{DynamicResource System7MenuShortcutBrush}" />
        <Setter Property="theme:System7Theme.IsMenuIconMember">
          <MultiBinding Converter="{x:Static render:System7MenuConverters.IsIconMember}">
            <Binding Path="Icon"
                     RelativeSource="{RelativeSource Self}" />
            <Binding Path="(theme:System7Theme.MonochromeIcon)"
                     RelativeSource="{RelativeSource Self}" />
            <Binding Path="(theme:System7Theme.MenuIconKind)"
                     RelativeSource="{RelativeSource Self}" />
            <Binding Path="(theme:System7Theme.ColorDepth)"
                     RelativeSource="{RelativeSource Self}" />
            <Binding Path="IsEffectivelyEnabled"
                     RelativeSource="{RelativeSource Self}" />
          </MultiBinding>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Name="Root" Background="Transparent">
              <Rectangle Name="Paper" />
              <Rectangle Name="Separator" Height="1" Margin="0,8,0,0" VerticalAlignment="Top" IsVisible="False" />
              <Grid Name="Row" ColumnDefinitions="14,Auto,Auto,*" Margin="0,0,10,0">
                <Grid.Margin>
                  <MultiBinding Converter="{x:Static render:System7MenuConverters.RowMargin}">
                    <Binding Path="#IconCell.DataContext" />
                    <TemplateBinding Property="ItemCount" />
                    <TemplateBinding Property="InputGesture" />
                  </MultiBinding>
                </Grid.Margin>
                <Grid.Tag>
                  <MultiBinding Converter="{x:Static render:System7MenuConverters.TextStyle}">
                    <Binding Path="(theme:System7Theme.TextStyle)"
                             RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                    <Binding Path="FontWeight"
                             RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                    <Binding Path="FontStyle"
                             RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                  </MultiBinding>
                </Grid.Tag>
                <!-- The mark, two pixels in. -->
                <Panel Name="MarkCell" Margin="2,0,0,0" HorizontalAlignment="Left">
                  <TextBlock Name="Mark" VerticalAlignment="Top"
                             LineHeight="{DynamicResource System7TextLineHeight}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static render:System7MenuConverters.Mark}">
                        <TemplateBinding Property="theme:System7Theme.MenuMark" />
                        <TemplateBinding Property="IsChecked" />
                      </MultiBinding>
                    </TextBlock.Text>
                    <TextBlock.Margin>
                      <MultiBinding Converter="{x:Static render:System7MenuConverters.TextMargin}">
                        <Binding Path="#IconCell.DataContext" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </TextBlock.Margin>
                  </TextBlock>
                  <Rectangle Name="MarkGray" render:System7Pattern.Kind="Gray" IsVisible="False" />
                </Panel>
                <Panel Name="IconCell" Grid.Column="1" x:DataType="render:System7MenuIconParts"
                       Height="{Binding CellHeight}"
                       IsVisible="{Binding $self.DataContext,
                                           Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Panel.DataContext>
                    <MultiBinding Converter="{x:Static render:System7MenuConverters.Icon}">
                      <Binding Path="Icon"
                               RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                      <Binding Path="(theme:System7Theme.MonochromeIcon)"
                               RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                      <Binding Path="(theme:System7Theme.MenuIconKind)"
                               RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                      <Binding Path="(theme:System7Theme.ColorDepth)"
                               RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                      <Binding Path="IsEffectivelyEnabled"
                               RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                    </MultiBinding>
                  </Panel.DataContext>
                  <Panel Name="Icon"
                         Width="{Binding Width}"
                         Height="{Binding Height}"
                         Margin="{Binding Margin}"
                         HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Path Name="IconPaper"
                          Data="{Binding Mask}" />
                    <Path Name="IconInk"
                          Data="{Binding Ink}" />
                    <Image Source="{Binding Image}"
                           Stretch="None" />
                    <Panel IsVisible="{Binding Mask, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Rectangle Name="IconGray"
                                 Clip="{Binding Mask}"
                                 render:System7Pattern.Kind="Gray" IsVisible="False" />
                    </Panel>
                  </Panel>
                </Panel>
                <!-- The text; a disabled color item without a true gray is grayed across its advance. -->
                <Panel Name="TextCell" Grid.Column="2"
                       IsVisible="{TemplateBinding Header,
                                                   Converter={x:Static render:System7TextConverters.IsText}}">
                  <TextBlock Name="Text" VerticalAlignment="Top"
                             LineHeight="{DynamicResource System7TextLineHeight}"
                             Text="{TemplateBinding Header}">
                    <TextBlock.Margin>
                      <MultiBinding Converter="{x:Static render:System7MenuConverters.TextMargin}">
                        <Binding Path="#IconCell.DataContext" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </TextBlock.Margin>
                  </TextBlock>
                  <Path Name="StyledText" VerticalAlignment="Top">
                    <Path.Margin>
                      <MultiBinding Converter="{x:Static render:System7MenuConverters.TextMargin}">
                        <Binding Path="#IconCell.DataContext" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Margin>
                    <Path.Data>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.StyledGlyphs}">
                        <TemplateBinding Property="Header" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Data>
                    <Path.Width>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.StyledWidth}">
                        <TemplateBinding Property="Header" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Width>
                    <Path.Height>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.StyledHeight}">
                        <TemplateBinding Property="Header" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Height>
                  </Path>
                  <Rectangle Name="TextGray" render:System7Pattern.Kind="Gray" IsVisible="False" />
                </Panel>
              </Grid>
              <!-- The submenu arrow or command key, 24 pixels from the right. -->
              <Panel Name="Accessory" Width="24" HorizontalAlignment="Right">
                <Panel HorizontalAlignment="Left">
                  <Path Name="Arrow" Width="16" Height="16" VerticalAlignment="Top"
                        Data="{StaticResource System7MenuSubmenuArrowGeometry}">
                    <Path.Margin>
                      <MultiBinding Converter="{x:Static render:System7MenuConverters.TextMargin}">
                        <Binding Path="#IconCell.DataContext" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Margin>
                  </Path>
                  <TextBlock Name="Shortcut" VerticalAlignment="Top"
                             LineHeight="{DynamicResource System7TextLineHeight}"
                             Text="{TemplateBinding InputGesture,
                                                    Converter={x:Static render:System7MenuConverters.Shortcut}}">
                    <TextBlock.Margin>
                      <MultiBinding Converter="{x:Static render:System7MenuConverters.TextMargin}">
                        <Binding Path="#IconCell.DataContext" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </TextBlock.Margin>
                  </TextBlock>
                  <Rectangle Name="AccessoryGray" render:System7Pattern.Kind="Gray" IsVisible="False" />
                </Panel>
              </Panel>
              <ContentPresenter Name="PART_HeaderPresenter" Margin="14,0,10,0" VerticalContentAlignment="Center" ClipToBounds="True"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                IsVisible="{TemplateBinding Header,
                                                            Converter={x:Static render:System7TextConverters.IsCustom}}" />
              <!-- A disabled one-bit item is grayed across its rows. -->
              <Rectangle Name="Gray" render:System7Pattern.Kind="Gray" IsVisible="False">
                <Rectangle.Margin>
                  <MultiBinding Converter="{x:Static render:System7MenuConverters.GrayMargin}">
                    <Binding Path="Bounds.Height"
                             RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="#IconCell.DataContext" />
                  </MultiBinding>
                </Rectangle.Margin>
              </Rectangle>
              <Popup Name="PART_Popup"
                     IsOpen="{TemplateBinding IsSubMenuOpen,
                                              Mode=TwoWay}"
                     ShouldUseOverlayLayer="True" InheritsTransform="True">
                <controls:System7MenuSurface Theme="{StaticResource System7MenuSurfaceTheme}"
                                             IsEnabled="{TemplateBinding IsEffectivelyEnabled}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </controls:System7MenuSurface>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Rectangle#AccessoryGray, ^ /template/ Rectangle#IconGray">
          <Setter Property="render:System7Pattern.Ink">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- A separator is a gray line through the middle of its row. -->
        <Style Selector="^:separator">
          <Style Selector="^ /template/ Rectangle#Separator">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="render:System7Pattern.Ink">
              <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
                <Binding Path="Foreground"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ Grid#Row">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
        <Style Selector="^:separator /template/ Rectangle#Separator">
          <Setter Property="render:System7Pattern.Kind">
            <MultiBinding Converter="{x:Static render:System7Colors.DithersPattern}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Path#Arrow">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="(theme:System7Theme.MenuShortcutBrush)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ TextBlock#Shortcut">
          <Setter Property="TextElement.Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="(theme:System7Theme.MenuShortcutBrush)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Path#Arrow">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="(theme:System7Theme.MenuShortcutBrush)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#Shortcut">
          <Setter Property="TextElement.Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="(theme:System7Theme.MenuShortcutBrush)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#AccessoryGray">
          <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static render:System7Colors.Dithers}">
              <Binding Path="(theme:System7Theme.MenuShortcutBrush)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Path#Arrow">
          <Setter Property="IsVisible"
                  Value="{Binding ItemCount,
                                  RelativeSource={RelativeSource AncestorType=MenuItem},
                                  Converter={x:Static render:System7MenuConverters.HasSubmenu}}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#Shortcut">
          <Setter Property="IsVisible"
                  Value="{Binding ItemCount,
                                  RelativeSource={RelativeSource AncestorType=MenuItem},
                                  Converter={x:Static render:System7MenuConverters.HasNoSubmenu}}" />
        </Style>
        <!-- A thresholded icon: its mask in the paper and its dark pixels in the ink; a disabled one without a true gray is grayed over its mask. -->
        <Style Selector="^ /template/ Path#IconPaper">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Path#IconInk">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Path#IconInk">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ Rectangle#IconGray">
          <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static render:System7Colors.Dithers}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^[(theme|System7Theme.IsMenuIconMember)=False] /template/ Rectangle#IconGray">
          <Setter Property="render:System7Pattern.Inverse" Value="True" />
        </Style>
        <!-- A selected enabled item reverses. -->
        <Style Selector="^:selected:not(:disabled):not(:separator)">
          <Style Selector="^ /template/ Rectangle#Paper">
            <Setter Property="Fill">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Foreground"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ TextBlock#Text, ^ /template/ ContentPresenter#PART_HeaderPresenter, ^ /template/ TextBlock#Mark">
            <Setter Property="TextElement.Foreground">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ Path#StyledText">
            <Setter Property="Fill">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ TextBlock#Shortcut">
            <Setter Property="TextElement.Foreground">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ Path#Arrow">
            <Setter Property="Fill">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <!-- A selected thresholded icon swaps its bits; a cicn's one-bit member keeps them. -->
          <Style Selector="^[(theme|System7Theme.IsMenuIconMember)=False]">
            <Style Selector="^ /template/ Path#IconPaper">
              <Setter Property="Fill">
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <Binding Path="Foreground"
                           RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                </MultiBinding>
              </Setter>
            </Style>
            <Style Selector="^ /template/ Path#IconInk">
              <Setter Property="Fill">
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <Binding Path="Background"
                           RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                </MultiBinding>
              </Setter>
            </Style>
          </Style>
        </Style>
        <!-- One bit: the item's own colors, a mark in the text color, and disabled rows grayed through the pattern. -->
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome]">
          <Style Selector="^:disabled:not(:separator) /template/ Rectangle#Gray">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Rectangle#TextGray, ^ /template/ Rectangle#MarkGray, ^ /template/ Rectangle#AccessoryGray, ^ /template/ Rectangle#IconGray">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ TextBlock#Mark">
            <Setter Property="TextElement.Foreground"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=MenuItem}}" />
          </Style>
          <Style Selector="^ /template/ Path#Arrow">
            <Setter Property="Fill"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=MenuItem}}" />
          </Style>
          <Style Selector="^ /template/ TextBlock#Shortcut">
            <Setter Property="TextElement.Foreground"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=MenuItem}}" />
          </Style>
          <Style Selector="^:selected:not(:disabled):not(:separator) /template/ Path#Arrow">
            <Setter Property="Fill"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=MenuItem}}" />
          </Style>
          <Style Selector="^:selected:not(:disabled):not(:separator) /template/ TextBlock#Shortcut">
            <Setter Property="TextElement.Foreground"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=MenuItem}}" />
          </Style>
          <Style Selector="^:selected:not(:disabled):not(:separator) /template/ TextBlock#Mark">
            <Setter Property="TextElement.Foreground"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=MenuItem}}" />
          </Style>
        </Style>
        <!-- A submenu opens beside its item. Menu tracking places it as MDEF 0 does instead. -->
        <Style Selector="^ /template/ Popup#PART_Popup">
          <Setter Property="Placement" Value="RightEdgeAlignedTop" />
          <Setter Property="HorizontalOffset" Value="-5" />
          <Setter Property="VerticalOffset" Value="-1" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7ComboBoxItemTheme" TargetType="ComboBoxItem"
                    BasedOn="{StaticResource System7MenuRowTheme}">
        <Setter Property="FocusAdorner"
                Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight"
                Value="{DynamicResource System7MenuItemHeight}" />
        <Setter Property="Height"
                Value="{DynamicResource System7MenuItemHeight}" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="theme:System7Theme.IsMenuSeparator"
                Value="{Binding Content,
                                RelativeSource={RelativeSource Self},
                                Converter={x:Static render:System7MenuConverters.IsSeparator}}" />
        <!-- Pop-up tracking marks the item under the pointer; without it the item under the pointer is highlighted. -->
        <Setter Property="theme:System7Theme.IsPopupItemHighlighted"
                Value="{Binding IsPointerOver,
                                RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Name="Root" Background="Transparent">
              <Rectangle Name="Paper" />
              <Rectangle Name="Separator" Height="1" Margin="0,8,0,0" VerticalAlignment="Top" IsVisible="False" />
              <Grid Name="Row" ColumnDefinitions="14,Auto,Auto,*" Margin="0,0,10,0">
                <Grid.Tag>
                  <MultiBinding Converter="{x:Static render:System7MenuConverters.TextStyle}">
                    <Binding Path="(theme:System7Theme.TextStyle)"
                             RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                    <Binding Path="FontWeight"
                             RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                    <Binding Path="FontStyle"
                             RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                  </MultiBinding>
                </Grid.Tag>
                <!-- The mark, two pixels in. -->
                <Panel Name="MarkCell" Margin="2,0,0,0" HorizontalAlignment="Left">
                  <TextBlock Name="Mark" VerticalAlignment="Top"
                             LineHeight="{DynamicResource System7TextLineHeight}"
                             Text="{TemplateBinding IsSelected,
                                                    Converter={x:Static render:System7MenuConverters.CheckMark}}" />
                  <Rectangle Name="MarkGray" render:System7Pattern.Kind="Gray" IsVisible="False" />
                </Panel>
                <!-- The text; a disabled color item without a true gray is grayed across its advance. -->
                <Panel Name="TextCell" Grid.Column="2"
                       IsVisible="{TemplateBinding Content,
                                                   Converter={x:Static render:System7TextConverters.IsText}}">
                  <TextBlock Name="Text" VerticalAlignment="Top"
                             LineHeight="{DynamicResource System7TextLineHeight}"
                             Text="{TemplateBinding Content}" />
                  <Path Name="StyledText" VerticalAlignment="Top">
                    <Path.Data>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.StyledGlyphs}">
                        <TemplateBinding Property="Content" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Data>
                    <Path.Width>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.StyledWidth}">
                        <TemplateBinding Property="Content" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Width>
                    <Path.Height>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.StyledHeight}">
                        <TemplateBinding Property="Content" />
                        <Binding Path="#Row.Tag" />
                      </MultiBinding>
                    </Path.Height>
                  </Path>
                  <Rectangle Name="TextGray" render:System7Pattern.Kind="Gray" IsVisible="False" />
                </Panel>
              </Grid>
              <ContentPresenter Name="PART_HeaderPresenter" Margin="14,0,10,0" VerticalContentAlignment="Center" ClipToBounds="True"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                IsVisible="{TemplateBinding Content,
                                                            Converter={x:Static render:System7TextConverters.IsCustom}}" />
              <!-- A disabled one-bit item is grayed across its rows. -->
              <Rectangle Name="Gray" render:System7Pattern.Kind="Gray" IsVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- A separator is a gray line through the middle of its row. -->
        <Style Selector="^[(theme|System7Theme.IsMenuSeparator)=True]">
          <Style Selector="^ /template/ Rectangle#Separator">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="render:System7Pattern.Ink">
              <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
                <Binding Path="Foreground"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ Grid#Row">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
        <Style Selector="^[(theme|System7Theme.IsMenuSeparator)=True] /template/ Rectangle#Separator">
          <Setter Property="render:System7Pattern.Kind">
            <MultiBinding Converter="{x:Static render:System7Colors.DithersPattern}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- A selected enabled item reverses. -->
        <Style Selector="^[(theme|System7Theme.IsPopupItemHighlighted)=True]:not(:disabled)">
          <Style Selector="^ /template/ Rectangle#Paper">
            <Setter Property="Fill">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Foreground"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ TextBlock#Text, ^ /template/ ContentPresenter#PART_HeaderPresenter, ^ /template/ TextBlock#Mark">
            <Setter Property="TextElement.Foreground">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ Path#StyledText">
            <Setter Property="Fill">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=ComboBoxItem}" />
              </MultiBinding>
            </Setter>
          </Style>
        </Style>
        <!-- One bit: the item's own colors, a mark in the text color, and disabled rows grayed through the pattern. -->
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome]">
          <Style Selector="^:disabled /template/ Rectangle#Gray">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Rectangle#TextGray, ^ /template/ Rectangle#MarkGray">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ TextBlock#Mark">
            <Setter Property="TextElement.Foreground"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
          </Style>
          <Style Selector="^[(theme|System7Theme.IsPopupItemHighlighted)=True]:not(:disabled) /template/ TextBlock#Mark">
            <Setter Property="TextElement.Foreground"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" />
          </Style>
        </Style>
      </ControlTheme>
      <!-- CDEF 63's pop-up: its title, then the current item in a box with a drop shadow and a triangle. -->
      <ControlTheme x:Key="System7ComboBoxTheme" TargetType="ComboBox">
        <Setter Property="theme:System7Theme.MenuFlashCount"
                Value="{DynamicResource System7MenuFlashCount}" />
        <Setter Property="theme:System7Theme.MenuFlashInterval"
                Value="{DynamicResource System7MenuFlashInterval}" />
        <Setter Property="theme:System7Theme.IsPopupSelectionEnabled"
                Value="{Binding SelectedItem,
                                RelativeSource={RelativeSource Self},
                                Converter={x:Static render:System7TextConverters.IsItemEnabled}}" />
        <Setter Property="FocusAdorner"
                Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight"
                Value="{DynamicResource System7ControlHeight}" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="ItemContainerTheme"
                Value="{StaticResource System7ComboBoxItemTheme}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Panel IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Fill="{TemplateBinding Background}" />
                <Grid Height="19" VerticalAlignment="Top" ColumnDefinitions="Auto,*"
                      Margin="{Binding Bounds.Height,
                                       RelativeSource={RelativeSource TemplatedParent},
                                       Converter={x:Static render:System7LayoutConverters.CenterTop},
                                       ConverterParameter=19}">
                  <Panel Name="TitleColumn"
                         Width="{TemplateBinding theme:System7Theme.PopupTitleWidth}">
                    <Rectangle Name="TitleHighlight" Margin="0,1,0,0" Height="16" VerticalAlignment="Top"
                               Fill="{TemplateBinding Foreground}"
                               IsVisible="False" />
                    <TextBlock Name="Title" Margin="4,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                               LineHeight="{DynamicResource System7TextLineHeight}"
                               render:System7Pattern.Inverse="True">
                      <TextBlock.Text>
                        <MultiBinding Converter="{x:Static render:System7TextConverters.Label}"
                                      ConverterParameter="8">
                          <TemplateBinding Property="theme:System7Theme.PopupTitle" />
                          <Binding Path="#TitleColumn.Bounds.Width" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Panel>
                  <Panel Name="Box" Grid.Column="1">
                    <Panel.MinWidth>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.PopupWidth}">
                        <Binding Path="Items"
                                 RelativeSource="{RelativeSource TemplatedParent}" />
                        <TemplateBinding Property="ItemCount" />
                      </MultiBinding>
                    </Panel.MinWidth>
                    <TextBlock Name="Item" Margin="15,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                               LineHeight="{DynamicResource System7TextLineHeight}"
                               render:System7Pattern.Inverse="True">
                      <TextBlock.Text>
                        <MultiBinding Converter="{x:Static render:System7TextConverters.PopupLabel}"
                                      ConverterParameter="33">
                          <TemplateBinding Property="SelectionBoxItem" />
                          <TemplateBinding Property="PlaceholderText" />
                          <Binding Path="#Box.Bounds.Width" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <Rectangle Classes="frame" Margin="0,0,1,0" Height="18" VerticalAlignment="Top"
                               Clip="{Binding $self.Bounds,
                                              Converter={x:Static render:System7RoundRectConverter.Instance},
                                              ConverterParameter='0;Pen=1'}" />
                    <Rectangle Classes="frame" Margin="0,3,0,0" Width="1" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <Rectangle Classes="frame" Margin="3,18,0,0" Height="1" VerticalAlignment="Top" />
                    <Path Name="Triangle" Margin="0,6,7,0" Width="11" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Data="{StaticResource System7PopupTriangleGeometry}" />
                  </Panel>
                </Grid>
              </Panel>
              <Grid Height="19" VerticalAlignment="Top" ColumnDefinitions="Auto,*"
                    Margin="{Binding Bounds.Height,
                                     RelativeSource={RelativeSource TemplatedParent},
                                     Converter={x:Static render:System7LayoutConverters.CenterTop},
                                     ConverterParameter=19}">
                <Panel Width="{TemplateBinding theme:System7Theme.PopupTitleWidth}" />
                <Panel Grid.Column="1" Margin="15,1,18,2">
                  <ContentPresenter Name="PART_SelectionPresenter"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ClipToBounds="True"
                                    IsVisible="{TemplateBinding SelectionBoxItem,
                                                                Converter={x:Static render:System7TextConverters.IsCustom}}" />
                  <TextBox Name="PART_EditableTextBox"
                           Text="{TemplateBinding Text,
                                                  Mode=TwoWay}"
                           PlaceholderText="{TemplateBinding PlaceholderText}"
                           IsVisible="{TemplateBinding IsEditable}"
                           Foreground="{TemplateBinding Foreground}"
                           Background="{TemplateBinding Background}"
                           BorderThickness="0" Padding="0" MinHeight="0" />
                </Panel>
              </Grid>
              <Popup Name="PART_Popup"
                     IsOpen="{TemplateBinding IsDropDownOpen,
                                              Mode=TwoWay}"
                     PlacementTarget="{TemplateBinding}"
                     ShouldUseOverlayLayer="True" InheritsTransform="True" IsLightDismissEnabled="True">
                <controls:System7MenuSurface Name="PART_PopupMenu"
                                             Theme="{StaticResource System7PopupMenuSurfaceTheme}"
                                             Foreground="{TemplateBinding Foreground}"
                                             SurfaceBackground="{TemplateBinding Background}"
                                             ScrollIndicatorBrush="{TemplateBinding Foreground}">
                  <controls:System7MenuSurface.MinWidth>
                    <MultiBinding Converter="{x:Static render:System7LayoutConverters.PopupMinWidth}">
                      <TemplateBinding Property="Bounds" />
                      <TemplateBinding Property="theme:System7Theme.UseNativePopupTracking" />
                    </MultiBinding>
                  </controls:System7MenuSurface.MinWidth>
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </controls:System7MenuSurface>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ TextBlock#Title, ^ /template/ TextBlock#Item, ^ /template/ :is(Shape).frame, ^ /template/ Path#Triangle">
          <Setter Property="render:System7Pattern.Ink"
                  Value="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=ComboBox}}" />
        </Style>
        <!-- Without pop-up tracking, the list opens below the box, as Avalonia's pop-ups do. -->
        <Style Selector="^[(theme|System7Theme.UseNativePopupTracking)=False]">
          <Style Selector="^ /template/ Popup#PART_Popup">
            <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
          </Style>
        </Style>
        <Style Selector="^[IsEditable=True] /template/ TextBlock#Item">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Without its current item enabled, the item's text and the triangle are gray. -->
        <Style Selector="^[(theme|System7Theme.IsPopupSelectionEnabled)=False] /template/ TextBlock#Item, ^[(theme|System7Theme.IsPopupSelectionEnabled)=False] /template/ Path#Triangle">
          <Setter Property="render:System7Pattern.Kind" Value="Gray" />
        </Style>
        <!-- Held down, the title reverses. -->
        <Style Selector="^:dropdownopen">
          <Style Selector="^ /template/ Rectangle#TitleHighlight">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ TextBlock#Title">
            <Setter Property="render:System7Pattern.Ink"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=ComboBox}}" />
          </Style>
        </Style>
        <!-- Disabled or without items, the pop-up is gray and never reverses. -->
        <Style Selector="^:disabled, ^[ItemCount=0]">
          <Style Selector="^ /template/ TextBlock#Title, ^ /template/ TextBlock#Item, ^ /template/ :is(Shape).frame, ^ /template/ Path#Triangle">
            <Setter Property="render:System7Pattern.Kind" Value="Gray" />
          </Style>
          <Style Selector="^ /template/ Rectangle#TitleHighlight">
            <Setter Property="IsVisible" Value="False" />
          </Style>
          <Style Selector="^ /template/ TextBlock#Title">
            <Setter Property="render:System7Pattern.Ink"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ComboBox}}" />
          </Style>
        </Style>
      </ControlTheme>
      <x:Double x:Key="System7ListItemHeight">16</x:Double>
      <SolidColorBrush x:Key="System7SelectionBackgroundBrush" Color="Black" />
      <ControlTheme x:Key="System7ListScrollViewerTheme" TargetType="ScrollViewer"
                    BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="ClipToBounds" Value="False" />
        <Style Selector="^ /template/ ScrollBar#PART_VerticalScrollBar">
          <Setter Property="Margin" Value="0,-1,0,-1" />
        </Style>
        <Style Selector="^ /template/ ScrollBar#PART_HorizontalScrollBar">
          <Setter Property="Margin" Value="-1,0,-1,0" />
        </Style>
      </ControlTheme>
      <!-- A document window's scroll bars: each overlaps the title bar's or the header's line, the frame's line, and the other bar by one pixel. Both always show. -->
      <ControlTheme x:Key="System7WindowScrollViewerTheme" TargetType="ScrollViewer"
                    BasedOn="{StaticResource System7ListScrollViewerTheme}">
        <Style Selector="^ /template/ ScrollBar#PART_VerticalScrollBar">
          <Setter Property="Margin" Value="0,-1,-1,-1" />
          <Setter Property="Visibility" Value="Visible" />
        </Style>
        <Style Selector="^ /template/ ScrollBar#PART_HorizontalScrollBar">
          <Setter Property="Margin" Value="-1,0,-1,-1" />
          <Setter Property="Visibility" Value="Visible" />
        </Style>
        <Style Selector="^ /template/ Grid > Panel">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ControlTheme>
      <!-- LDEF 0's text cell: the text four pixels in, condensed and then truncated when it does not fit, and reversed while selected. -->
      <ControlTheme x:Key="System7ListBoxItemTheme" TargetType="ListBoxItem">
        <Setter Property="FocusAdorner"
                Value="{x:Null}" />
        <Setter Property="Padding" Value="4,0,1,0" />
        <Setter Property="MinHeight"
                Value="{DynamicResource System7ListItemHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Foreground"
                Value="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=ListBox},
                                FallbackValue={StaticResource System7ControlForegroundBrush}}" />
        <Setter Property="Background"
                Value="{Binding Background,
                                RelativeSource={RelativeSource AncestorType=ListBox},
                                FallbackValue={StaticResource System7ControlBackgroundBrush}}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" ClipToBounds="True">
              <Rectangle Name="Paper" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter.DataTemplates>
                  <DataTemplate DataType="x:String">
                    <TextBlock Height="16"
                               LineHeight="{DynamicResource System7TextLineHeight}">
                      <TextBlock.Text>
                        <MultiBinding Converter="{x:Static render:System7TextConverters.CondensedLabel}">
                          <Binding />
                          <Binding Path="Bounds.Width"
                                   RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                      </TextBlock.Text>
                      <TextBlock.LetterSpacing>
                        <MultiBinding Converter="{x:Static render:System7TextConverters.Condense}">
                          <Binding />
                          <Binding Path="Bounds.Width"
                                   RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                      </TextBlock.LetterSpacing>
                    </TextBlock>
                  </DataTemplate>
                </ContentPresenter.DataTemplates>
              </ContentPresenter>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Rectangle#Paper">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- A selected cell in an active list swaps its background and the highlight color. -->
        <Style Selector="^[(theme|System7Theme.IsActive)=True]:selected /template/ Rectangle#Paper">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Highlight}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.SelectionBrush)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^[(theme|System7Theme.IsActive)=True]:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Highlight}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.SelectionBrush)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- One bit: the list's own colors, reversed while selected. -->
        <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome]">
          <Style Selector="^ /template/ Rectangle#Paper">
            <Setter Property="Fill"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
          </Style>
          <Style Selector="^[(theme|System7Theme.IsActive)=True]:selected /template/ Rectangle#Paper">
            <Setter Property="Fill"
                    Value="{Binding Foreground,
                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
          </Style>
          <Style Selector="^[(theme|System7Theme.IsActive)=True]:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
          </Style>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7ListBoxTheme" TargetType="ListBox"
                    BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="theme:System7Theme.UseNativeListTracking" Value="True" />
        <Setter Property="theme:System7Theme.SelectionBrush"
                Value="{DynamicResource System7SelectionBackgroundBrush}" />
        <Setter Property="FocusAdorner"
                Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="ItemContainerTheme"
                Value="{StaticResource System7ListBoxItemTheme}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="border"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    RenderOptions.EdgeMode="Aliased">
              <Border.Background>
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <TemplateBinding Property="Background" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </Border.Background>
              <Border.BorderBrush>
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <TemplateBinding Property="BorderBrush" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </Border.BorderBrush>
              <ScrollViewer Name="PART_ScrollViewer" Background="Transparent"
                            AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                            BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                            IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                            VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}"
                            HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                Margin="{TemplateBinding Padding}"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ScrollViewer#PART_ScrollViewer">
          <Setter Property="Theme"
                  Value="{StaticResource System7ListScrollViewerTheme}" />
        </Style>
        <!-- A list that fills a window with scroll bars: no frame of its own, and the window's paper shows in the grow box's corner. -->
        <Style Selector="^.windowScroll">
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Style Selector="^ /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="Theme"
                    Value="{StaticResource System7WindowScrollViewerTheme}" />
          </Style>
        </Style>
      </ControlTheme>
      <!-- An icon cell keeps the list's paper while selected; its label or icon reverses instead. -->
      <ControlTheme x:Key="System7IconCellTheme" TargetType="ListBoxItem"
                    BasedOn="{StaticResource System7ListBoxItemTheme}">
        <Style Selector="^[(theme|System7Theme.IsActive)=True]:selected /template/ Rectangle#Paper">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
      </ControlTheme>
      <x:Double x:Key="System7IconListItemWidth">112</x:Double>
      <x:Double x:Key="System7IconListItemHeight">64</x:Double>
      <!-- A large-icon cell: the icon centered above its label, whose band reverses while selected. -->
      <ControlTheme x:Key="System7IconListBoxItemTheme" TargetType="ListBoxItem"
                    BasedOn="{StaticResource System7IconCellTheme}">
        <Setter Property="Width"
                Value="{DynamicResource System7IconListItemWidth}" />
        <Setter Property="Height"
                Value="{DynamicResource System7IconListItemHeight}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" ClipToBounds="True">
              <Rectangle Name="Paper" />
              <StackPanel VerticalAlignment="Center">
                <Image Name="Icon" Width="32" Height="32" HorizontalAlignment="Center" Stretch="None" />
                <Border Name="Band" Height="16" Padding="1,1,0,0" HorizontalAlignment="Left"
                        IsVisible="{TemplateBinding theme:System7Theme.ShowListLabel}">
                  <Border.Margin>
                    <MultiBinding Converter="{x:Static render:System7TextConverters.CenterMargin}">
                      <Binding Path="#Label.Text" />
                      <Binding Path="Bounds.Width"
                               RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                  </Border.Margin>
                  <TextBlock Name="Label"
                             LineHeight="{DynamicResource System7TextLineHeight}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static render:System7TextConverters.MiddleLabel}"
                                    ConverterParameter="2">
                        <TemplateBinding Property="Content" />
                        <Binding Path="Bounds.Width"
                                 RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </Border>
              </StackPanel>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Image#Icon">
          <Setter Property="Source">
            <MultiBinding Converter="{x:Static render:System7IconConverters.Image}">
              <Binding Path="(theme:System7Theme.ListIcon)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ TextBlock#Label">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^[(theme|System7Theme.IsActive)=True]:selected">
          <Style Selector="^ /template/ Image#Icon">
            <Setter Property="Source">
              <MultiBinding Converter="{x:Static render:System7IconConverters.Image}"
                            ConverterParameter="Selected">
                <Binding Path="(theme:System7Theme.ListIcon)"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ Border#Band">
            <Setter Property="Background">
              <MultiBinding Converter="{x:Static render:System7Colors.Highlight}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                <Binding Path="(theme:System7Theme.SelectionBrush)"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ TextBlock#Label">
            <Setter Property="Foreground">
              <MultiBinding Converter="{x:Static render:System7Colors.Highlight}">
                <Binding Path="Foreground"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                <Binding Path="(theme:System7Theme.SelectionBrush)"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              </MultiBinding>
            </Setter>
          </Style>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7IconListBoxTheme" TargetType="ListBox"
                    BasedOn="{StaticResource System7ListBoxTheme}">
        <Setter Property="ItemContainerTheme"
                Value="{StaticResource System7IconListBoxItemTheme}" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </Setter>
      </ControlTheme>
      <x:Double x:Key="System7SmallIconListItemHeight">20</x:Double>
      <!-- A small-icon cell: a one-bit icon at the left or right edge beside its label, which may be styled. -->
      <ControlTheme x:Key="System7SmallIconListBoxItemTheme" TargetType="ListBoxItem"
                    BasedOn="{StaticResource System7IconCellTheme}">
        <Setter Property="Height"
                Value="{DynamicResource System7SmallIconListItemHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent" ClipToBounds="True">
              <Rectangle Name="Paper" />
              <Path Name="Icon" Width="16" Height="16" Margin="0,-1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Data="{TemplateBinding theme:System7Theme.SmallListIcon,
                                           Converter={x:Static render:System7IconConverters.Ink}}" />
              <TextBlock Name="Label" Margin="19,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                         LineHeight="{DynamicResource System7TextLineHeight}"
                         Text="{Binding #StyledLabel.Tag}" />
              <Path Name="StyledLabel" Margin="19,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path.Tag>
                  <MultiBinding Converter="{x:Static render:System7TextConverters.StyledLabel}"
                                ConverterParameter="19">
                    <TemplateBinding Property="Content" />
                    <TemplateBinding Property="theme:System7Theme.TextStyle" />
                    <Binding Path="Bounds.Width"
                             RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </Path.Tag>
                <Path.Data>
                  <MultiBinding Converter="{x:Static render:System7TextConverters.StyledGlyphs}">
                    <Binding Path="Tag"
                             RelativeSource="{RelativeSource Self}" />
                    <TemplateBinding Property="theme:System7Theme.TextStyle" />
                  </MultiBinding>
                </Path.Data>
                <Path.Width>
                  <MultiBinding Converter="{x:Static render:System7TextConverters.StyledWidth}">
                    <Binding Path="Tag"
                             RelativeSource="{RelativeSource Self}" />
                    <TemplateBinding Property="theme:System7Theme.TextStyle" />
                  </MultiBinding>
                </Path.Width>
              </Path>
              <Rectangle Name="Gray" render:System7Pattern.Kind="Gray" render:System7Pattern.Local="True" IsVisible="False" />
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Path#Icon">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.SmallListIcon}">
              <Binding Path="(theme:System7Theme.SmallListIconBrush)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.SelectionBrush)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.SmallListDisabled)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ TextBlock#Label">
          <Setter Property="Foreground">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Path#StyledLabel">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Rectangle#Gray">
          <Setter Property="render:System7Pattern.Ink">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- A styled label is drawn with QuickDraw's styled glyphs. -->
        <Style Selector="^ /template/ TextBlock#Label">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ Path#StyledLabel">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[(theme|System7Theme.TextStyle)=Plain]">
          <Style Selector="^ /template/ TextBlock#Label">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ Path#StyledLabel">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </Style>
        <!-- With the icon at the right, the label ends 26 pixels from the edge. -->
        <Style Selector="^[(theme|System7Theme.SmallListIconOnRight)=True]">
          <Style Selector="^ /template/ Path#Icon">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,-1,4,0" />
          </Style>
          <Style Selector="^ /template/ TextBlock#Label, ^ /template/ Path#StyledLabel">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,1,26,0" />
          </Style>
        </Style>
        <!-- A disabled cell is gray, or on a one- or two-bit screen cleared through the gray pattern in its own phase. -->
        <Style Selector="^[(theme|System7Theme.SmallListDisabled)=True]">
          <Style Selector="^ /template/ TextBlock#Label">
            <Setter Property="Foreground"
                    Value="{Binding (theme:System7Theme.ColorDepth),
                                    RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                    Converter={x:Static render:System7Colors.DisabledGray}}" />
          </Style>
          <Style Selector="^ /template/ Path#StyledLabel">
            <Setter Property="Fill"
                    Value="{Binding (theme:System7Theme.ColorDepth),
                                    RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                    Converter={x:Static render:System7Colors.DisabledGray}}" />
          </Style>
          <Style Selector="^[(theme|System7Theme.ColorDepth)=Monochrome], ^[(theme|System7Theme.ColorDepth)=Indexed2]">
            <Style Selector="^ /template/ TextBlock#Label">
              <Setter Property="Foreground">
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <Binding Path="Foreground"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                </MultiBinding>
              </Setter>
            </Style>
            <Style Selector="^ /template/ Path#StyledLabel">
              <Setter Property="Fill">
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <Binding Path="Foreground"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                </MultiBinding>
              </Setter>
            </Style>
            <Style Selector="^ /template/ Rectangle#Gray">
              <Setter Property="IsVisible" Value="True" />
            </Style>
          </Style>
        </Style>
        <!-- An enabled selected cell in an active list reverses. -->
        <Style Selector="^[(theme|System7Theme.SmallListDisabled)=False]">
          <Style Selector="^[(theme|System7Theme.IsActive)=True]:selected">
            <Style Selector="^ /template/ Rectangle#Paper">
              <Setter Property="Fill">
                <MultiBinding Converter="{x:Static render:System7Colors.Highlight}">
                  <Binding Path="Background"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="Background"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.SelectionBrush)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                </MultiBinding>
              </Setter>
            </Style>
            <Style Selector="^ /template/ TextBlock#Label">
              <Setter Property="Foreground">
                <MultiBinding Converter="{x:Static render:System7Colors.Highlight}">
                  <Binding Path="Foreground"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="Background"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.SelectionBrush)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                </MultiBinding>
              </Setter>
            </Style>
            <Style Selector="^ /template/ Path#StyledLabel">
              <Setter Property="Fill">
                <MultiBinding Converter="{x:Static render:System7Colors.Highlight}">
                  <Binding Path="Foreground"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="Background"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.SelectionBrush)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                </MultiBinding>
              </Setter>
            </Style>
            <Style Selector="^ /template/ Path#Icon">
              <Setter Property="Fill">
                <MultiBinding Converter="{x:Static render:System7Colors.SmallListIcon}"
                              ConverterParameter="Highlighted">
                  <Binding Path="(theme:System7Theme.SmallListIconBrush)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="Foreground"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="Background"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.SelectionBrush)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                  <Binding Path="(theme:System7Theme.SmallListDisabled)"
                           RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                </MultiBinding>
              </Setter>
            </Style>
          </Style>
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7SmallIconListBoxTheme" TargetType="ListBox"
                    BasedOn="{StaticResource System7ListBoxTheme}">
        <Setter Property="ItemContainerTheme"
                Value="{StaticResource System7SmallIconListBoxItemTheme}" />
      </ControlTheme>
      <x:Int32 x:Key="System7MenuFlashCount">3</x:Int32>
      <Thickness x:Key="System7TextBoxPadding">2</Thickness>
      <x:Double x:Key="System7TextLineHeight">16</x:Double>
      <sys:TimeSpan x:Key="System7CaretBlinkInterval">00:00:00.200</sys:TimeSpan>
      <!-- TextEdit: the lines, selection, and caret on whole pixels, drawn over an invisible TextPresenter that edits the text. -->
      <ControlTheme x:Key="System7TextBoxTheme" TargetType="TextBox">
        <Setter Property="theme:System7Theme.UseNativeTextEditing" Value="True" />
        <Setter Property="FocusAdorner"
                Value="{x:Null}" />
        <Setter Property="CaretBlinkInterval"
                Value="{DynamicResource System7CaretBlinkInterval}" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7ControlBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource System7ControlForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="Black" />
        <Setter Property="SelectionForegroundBrush" Value="White" />
        <Setter Property="CaretBrush" Value="Black" />
        <Setter Property="PlaceholderForeground" Value="#808080" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding"
                Value="{DynamicResource System7TextBoxPadding}" />
        <Setter Property="LineHeight"
                Value="{DynamicResource System7TextLineHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <DataValidationErrors>
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ContentPresenter Grid.Column="0"
                                    Content="{TemplateBinding InnerLeftContent}" />
                  <ScrollViewer Name="PART_ScrollViewer" Grid.Column="1"
                                AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                                HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}">
                    <Panel>
                      <Panel IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle Fill="{TemplateBinding Background}" />
                        <ItemsControl ItemsSource="{TemplateBinding theme:System7Theme.TextLines}"
                                      ItemsPanel="{StaticResource System7LayerPanelTemplate}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="controls:System7TextLine">
                              <Panel>
                                <TextBlock Margin="{Binding TextMargin}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" LineHeight="16" TextWrapping="NoWrap"
                                           Text="{Binding Text}"
                                           Foreground="{Binding $parent[TextBox].Foreground}" />
                                <!-- The selection reverses its rows: the highlight, then the line again in the selection foreground, clipped to it. -->
                                <Panel Margin="{Binding SelectionMargin}"
                                       Width="{Binding SelectionWidth}"
                                       Height="{Binding Height}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"
                                       IsVisible="{Binding IsSelected}">
                                  <Rectangle Fill="{Binding $parent[TextBox].SelectionBrush}" />
                                  <TextBlock Margin="{Binding TextInSelectionMargin}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" LineHeight="16" TextWrapping="NoWrap"
                                             Text="{Binding Text}"
                                             Foreground="{Binding $parent[TextBox].SelectionForegroundBrush}" />
                                </Panel>
                              </Panel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- TextEdit XORs a one-pixel caret: ink under it turns to the background. -->
                        <Panel Margin="{TemplateBinding theme:System7Theme.TextCaretMargin}"
                               Width="1"
                               Height="{TemplateBinding theme:System7Theme.TextCaretHeight}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"
                               IsVisible="{TemplateBinding theme:System7Theme.ShowTextCaret}">
                          <Rectangle Fill="{TemplateBinding CaretBrush}" />
                          <TextBlock Margin="{TemplateBinding theme:System7Theme.TextInCaretMargin}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" LineHeight="16"
                                     Text="{TemplateBinding theme:System7Theme.TextCaretLine}"
                                     Foreground="{TemplateBinding Background}" />
                        </Panel>
                      </Panel>
                      <TextPresenter Name="PART_TextPresenter" Opacity="0"
                                     CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                     CaretIndex="{TemplateBinding CaretIndex}"
                                     LineHeight="{TemplateBinding LineHeight}"
                                     LetterSpacing="{TemplateBinding LetterSpacing}"
                                     PasswordChar="{TemplateBinding PasswordChar}"
                                     RevealPassword="{TemplateBinding RevealPassword}"
                                     SelectionStart="{TemplateBinding SelectionStart}"
                                     SelectionEnd="{TemplateBinding SelectionEnd}"
                                     Text="{TemplateBinding Text,
                                                            Mode=TwoWay}"
                                     TextAlignment="{TemplateBinding TextAlignment}"
                                     TextWrapping="{TemplateBinding TextWrapping}" />
                      <TextBlock IsHitTestVisible="False"
                                 Text="{TemplateBinding PlaceholderText}"
                                 Foreground="{TemplateBinding PlaceholderForeground}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 Margin="1,0,0,0"
                                 LineHeight="{TemplateBinding LineHeight}">
                        <TextBlock.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding ElementName="PART_TextPresenter" Path="PreeditText"
                                     Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                            <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                     Path="Text"
                                     Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                          </MultiBinding>
                        </TextBlock.IsVisible>
                      </TextBlock>
                    </Panel>
                  </ScrollViewer>
                  <ContentPresenter Grid.Column="2"
                                    Content="{TemplateBinding InnerRightContent}" />
                </Grid>
              </DataValidationErrors>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <x:Int32 x:Key="System7MenuFlashInterval">50</x:Int32>
      <x:TimeSpan x:Key="System7SubmenuDelay">0:0:0.1333333</x:TimeSpan>
      <x:TimeSpan x:Key="System7SubmenuAimDelay">0:0:1</x:TimeSpan>
      <x:Double x:Key="System7MenuBarHeight">20</x:Double>
      <x:Double x:Key="System7MenuItemHeight">16</x:Double>
      <!-- MDEF 0's menu title: reversed while its menu is down, and grayed through the pattern where the screen has no true gray. -->
      <ControlTheme x:Key="System7TopLevelMenuItemTheme" TargetType="MenuItem">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground"
                Value="{DynamicResource System7MenuTitleForegroundBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource System7MenuBarBackgroundBrush}" />
        <Setter Property="theme:System7Theme.IsAppleMenu"
                Value="{Binding Header,
                                RelativeSource={RelativeSource Self},
                                Converter={x:Static render:System7MenuConverters.IsApple}}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Background="Transparent">
              <Panel Name="PART_TitlePresenter" Margin="-1,0,-4,0" Height="19" VerticalAlignment="Top">
                <Rectangle Name="Highlight" Margin="0,1,0,0" Height="18" VerticalAlignment="Top" IsVisible="False" />
                <TextBlock Name="Title" Margin="9,2,9,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                           LineHeight="{DynamicResource System7TextLineHeight}"
                           Text="{TemplateBinding Header}"
                           IsVisible="{TemplateBinding Header,
                                                       Converter={x:Static render:System7TextConverters.IsText}}"
                           render:System7Pattern.Inverse="True" />
                <Image Name="Apple" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None"
                       IsVisible="False"
                       Margin="{Binding #PART_TitlePresenter.Bounds.Width,
                                        Converter={x:Static render:System7MenuConverters.AppleMargin}}" />
              </Panel>
              <ContentPresenter Name="PART_HeaderPresenter" Margin="8,0,10,0" VerticalContentAlignment="Center" ClipToBounds="True"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                IsVisible="{TemplateBinding Header,
                                                            Converter={x:Static render:System7TextConverters.IsCustom}}" />
              <Popup Name="PART_Popup"
                     IsOpen="{TemplateBinding IsSubMenuOpen,
                                              Mode=TwoWay}"
                     PlacementTarget="{Binding ElementName=PART_TitlePresenter}"
                     ShouldUseOverlayLayer="True" InheritsTransform="True" IsLightDismissEnabled="True"
                     OverlayInputPassThroughElement="{Binding $parent[Menu]}">
                <controls:System7MenuSurface Theme="{StaticResource System7MenuSurfaceTheme}"
                                             IsEnabled="{TemplateBinding IsEffectivelyEnabled}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </controls:System7MenuSurface>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Rectangle#Highlight">
          <Setter Property="Fill">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^ /template/ TextBlock#Title, ^ /template/ ContentPresenter#PART_HeaderPresenter">
          <Setter Property="render:System7Pattern.Ink">
            <MultiBinding Converter="{x:Static render:System7Colors.Map}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#Title">
          <Setter Property="render:System7Pattern.Ink">
            <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
          <Setter Property="render:System7Pattern.Kind">
            <MultiBinding Converter="{x:Static render:System7Colors.DithersPattern}">
              <Binding Path="Foreground"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="Background"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              <Binding Path="(theme:System7Theme.ColorDepth)"
                       RelativeSource="{RelativeSource AncestorType=MenuItem}" />
            </MultiBinding>
          </Setter>
        </Style>
        <!-- A title whose menu is down reverses, even while disabled. -->
        <Style Selector="^:open">
          <Style Selector="^ /template/ Rectangle#Highlight">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="^ /template/ TextBlock#Title">
            <Setter Property="render:System7Pattern.Ink">
              <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^:disabled /template/ TextBlock#Title">
            <Setter Property="render:System7Pattern.Ink">
              <MultiBinding Converter="{x:Static render:System7Colors.Gray}">
                <Binding Path="Background"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="Foreground"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
                <Binding Path="(theme:System7Theme.ColorDepth)"
                         RelativeSource="{RelativeSource AncestorType=MenuItem}" />
              </MultiBinding>
            </Setter>
          </Style>
          <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground"
                    Value="{Binding Background,
                                    RelativeSource={RelativeSource AncestorType=MenuItem}}" />
          </Style>
        </Style>
        <!-- The Apple menu's title is the color Apple icon on a screen with 16 colors or more. -->
        <Style Selector="^[(theme|System7Theme.IsAppleMenu)=True]:not(:disabled)">
          <Style Selector="^[(theme|System7Theme.ColorDepth)=Indexed4]">
            <Style Selector="^ /template/ Image#Apple">
              <Setter Property="Source"
                      Value="{StaticResource System7MenuApple4Image}" />
              <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ TextBlock#Title">
              <Setter Property="Opacity" Value="0" />
            </Style>
          </Style>
          <Style Selector="^[(theme|System7Theme.ColorDepth)=Indexed8]">
            <Style Selector="^ /template/ Image#Apple">
              <Setter Property="Source"
                      Value="{StaticResource System7MenuApple8Image}" />
              <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ TextBlock#Title">
              <Setter Property="Opacity" Value="0" />
            </Style>
          </Style>
          <Style Selector="^[(theme|System7Theme.ColorDepth)=Rgb555]">
            <Style Selector="^ /template/ Image#Apple">
              <Setter Property="Source"
                      Value="{StaticResource System7MenuApple16Image}" />
              <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ TextBlock#Title">
              <Setter Property="Opacity" Value="0" />
            </Style>
          </Style>
          <Style Selector="^[(theme|System7Theme.ColorDepth)=Rgb888]">
            <Style Selector="^ /template/ Image#Apple">
              <Setter Property="Source"
                      Value="{StaticResource System7MenuApple32Image}" />
              <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ TextBlock#Title">
              <Setter Property="Opacity" Value="0" />
            </Style>
          </Style>
        </Style>
        <!-- A menu opens below its title. Menu tracking places it as MDEF 0 does instead. -->
        <Style Selector="^ /template/ Popup#PART_Popup">
          <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="System7MenuTheme" TargetType="Menu"
                    BasedOn="{StaticResource {x:Type Menu}}">
        <Setter Property="theme:System7Theme.SubmenuDelay"
                Value="{DynamicResource System7SubmenuDelay}" />
        <Setter Property="theme:System7Theme.SubmenuAimDelay"
                Value="{DynamicResource System7SubmenuAimDelay}" />
        <Setter Property="theme:System7Theme.MenuFlashCount"
                Value="{DynamicResource System7MenuFlashCount}" />
        <Setter Property="theme:System7Theme.MenuFlashInterval"
                Value="{DynamicResource System7MenuFlashInterval}" />
        <Setter Property="Height"
                Value="{DynamicResource System7MenuBarHeight}" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="Background"
                Value="{DynamicResource System7MenuBarBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource System7MenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    RenderOptions.EdgeMode="Aliased">
              <Border.Background>
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <TemplateBinding Property="Background" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </Border.Background>
              <Border.BorderBrush>
                <MultiBinding Converter="{x:Static render:System7Colors.Map}">
                  <TemplateBinding Property="BorderBrush" />
                  <Binding Path="(theme:System7Theme.ColorDepth)"
                           RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </Border.BorderBrush>
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Setter Property="ItemContainerTheme"
                Value="{StaticResource System7TopLevelMenuItemTheme}" />
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <controls:System7MenuBarPanel />
          </ItemsPanelTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector=":is(TemplatedControl)">
    <Setter Property="FontFamily"
            Value="{DynamicResource System7SystemFontFamily}" />
    <Setter Property="FontSize"
            Value="{DynamicResource System7SystemFontSize}" />
    <Setter Property="theme:System7Theme.UseAliasedText" Value="True" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontFamily"
            Value="{DynamicResource System7SystemFontFamily}" />
    <Setter Property="FontSize"
            Value="{DynamicResource System7SystemFontSize}" />
    <Setter Property="theme:System7Theme.UseAliasedText" Value="True" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Theme"
            Value="{StaticResource System7MenuTheme}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Theme"
            Value="{StaticResource System7MenuItemTheme}" />
  </Style>
  <Style Selector="Menu &gt; MenuItem">
    <Setter Property="Theme"
            Value="{StaticResource System7TopLevelMenuItemTheme}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Theme"
            Value="{StaticResource System7ButtonTheme}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Theme"
            Value="{StaticResource System7CheckBoxTheme}" />
  </Style>
  <Style Selector="RadioButton">
    <Setter Property="Theme"
            Value="{StaticResource System7RadioButtonTheme}" />
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="Theme"
            Value="{StaticResource System7ScrollBarTheme}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Theme"
            Value="{StaticResource System7ComboBoxTheme}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Theme"
            Value="{StaticResource System7ComboBoxItemTheme}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Theme"
            Value="{StaticResource System7ListBoxTheme}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Theme"
            Value="{Binding ItemContainerTheme,
                            RelativeSource={RelativeSource AncestorType=ListBox},
                            FallbackValue={StaticResource System7ListBoxItemTheme}}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Theme"
            Value="{StaticResource System7TextBoxTheme}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Theme"
            Value="{StaticResource System7ProgressBarTheme}" />
  </Style>
  <Style Selector="controls|System7Desktop">
    <Setter Property="Background"
            Value="{DynamicResource System7DesktopBackgroundBrush}" />
  </Style>
  <Style Selector="controls|System7MemorySlider">
    <Setter Property="Theme"
            Value="{StaticResource System7MemorySliderTheme}" />
  </Style>
  <Style Selector="controls|System7SoundSlider">
    <Setter Property="Theme"
            Value="{StaticResource System7SoundSliderTheme}" />
  </Style>
  <Style Selector="controls|System7NetworkSlider">
    <Setter Property="Theme"
            Value="{StaticResource System7NetworkSliderTheme}" />
  </Style>
  <Style Selector="controls|System7SpeechSlider">
    <Setter Property="Theme"
            Value="{StaticResource System7SpeechSliderTheme}" />
  </Style>
  <Style Selector="controls|System7GrowBox">
    <Setter Property="Theme"
            Value="{StaticResource System7GrowBoxTheme}" />
  </Style>
  <Style Selector="controls|System7WindowFrame">
    <Setter Property="Theme"
            Value="{StaticResource System7WindowFrameTheme}" />
  </Style>
</Styles>
