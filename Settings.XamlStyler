{
  "AttributesTolerance": 1,
  "KeepFirstAttributeOnSameLine": true,
  "MaxAttributeCharactersPerLine": 110,
  "MaxAttributesPerLine": 10,
  "NewlineExemptionElements": "RadialGradientBrush, GradientStop, LinearGradientBrush, ScaleTransform, SkewTransform, RotateTransform, TranslateTransform, Trigger, Condition",
  "SeparateByGroups": false,
  "AttributeIndentation": 0,
  "AttributeIndentationStyle": 1,
  "RemoveDesignTimeReferences": false,
  "IgnoreDesignTimeReferencePrefix": false,
  "EnableAttributeReordering": false,
  "FirstLineAttributes": "",
  "OrderAttributesByName": false,
  "PutEndingBracketOnNewLine": false,
  "RemoveEndingTagOfEmptyElement": true,
  "SpaceBeforeClosingSlash": true,
  "RootElementLineBreakRule": 0,
  "ReorderVSM": 0,
  "ReorderGridChildren": false,
  "ReorderCanvasChildren": false,
  "ReorderSetters": 0,
  "FormatMarkupExtension": true,
  "NoNewLineMarkupExtensions": "x:Bind, StaticResource, DynamicResource, x:Static, RelativeSource",
  "ThicknessSeparator": 2,
  "ThicknessAttributes": "",
  "FormatOnSave": false,
  "CommentPadding": 1,
  "IndentSize": 2,
  "IndentWithTabs": false
}
