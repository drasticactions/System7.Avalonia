+
 LOCALVAR ui5r DisasmCounter = 0;
 
 GLOBALPROC DisasmOneOrSave(ui5r pc)
 {
+    if (AutomationTraceRemaining) {
+        /* Resource handles can use the high byte for flags in 24-bit addressing mode. */
+        ui5r address = pc & AutomationTraceMask;
+        if (AutomationTraceWaiting && address == AutomationTraceStart) AutomationTraceWaiting = falseblnr;
+        if (!AutomationTraceWaiting && (!AutomationTraceHigh ||
+            (address >= AutomationTraceLow && address < AutomationTraceHigh))) {
+            AutomationTracePCs[AutomationTraceCount++] = pc;
+            DisasmOneAndBack(pc);
+            --AutomationTraceRemaining;
+        }
+    }
 	if (0 != DisasmCounter) {
 		DisasmOneAndBack(pc);
 		--DisasmCounter;
